---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getUserFromCookie } from '@/lib/auth';
import User from '@/models/User';
import dbConnect from '@/lib/mongodb';
import { getCollection } from 'astro:content';

export const prerender = false;

const cookieHeader = Astro.request.headers.get('cookie');
const userPayload = getUserFromCookie(cookieHeader);

if (!userPayload) {
  return Astro.redirect('/404');
}

await dbConnect();

const currentUser = await User.findById(userPayload.userId);
if (!currentUser || (currentUser.role !== 'admin' && currentUser.role !== 'owner')) {
  return Astro.redirect('/404');
}

const users = await User.find({}).sort({ createdAt: -1 });

const allEpisodes = await getCollection('episodios');
const episodesData: Record<string, { title: string, image: string }> = {};
const clipsData: Record<string, { title: string, episodeSlug: string, image: string }> = {};

allEpisodes.forEach(e => {
    const epImage = typeof e.data.image === 'string' ? e.data.image : (e.data.image as any)?.src || '';
    episodesData[e.slug] = { title: e.data.title, image: epImage };
    if (e.data.clips) {
        e.data.clips.forEach((clip: any) => {
             const match = clip.url.match(/(?:youtube\.com\/shorts\/|youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^?&]+)/);
             const videoId = match ? match[1] : null;
             if (videoId) {
                 clipsData[videoId] = { title: clip.title, episodeSlug: e.slug, image: epImage };
             }
        });
    }
});

const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);

const totalUsers = users.length;
const subscribedCount = users.filter(u => u.newsletter).length;
const activeRecentCount = users.filter(u => u.lastActiveAt && new Date(u.lastActiveAt) > thirtyDaysAgo).length;
const newThisWeek = users.filter(u => new Date(u.createdAt) > sevenDaysAgo).length;
const totalListeningTime = users.reduce((acc, u) => acc + (u.listeningTime || 0), 0);
const avgListeningTime = totalUsers > 0 ? Math.round(totalListeningTime / totalUsers) : 0;

function formatTime(seconds: number) {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    return `${h}h ${m}m`;
}
---

<AdminLayout title="Usuarios">
  <div id="adminContainer" data-episodes={JSON.stringify(episodesData)} data-clips={JSON.stringify(clipsData)}>
    <div class="page-header">
      <div class="header-left">
        <h1>Usuarios</h1>
        <p class="subtitle">Gestión completa de la base de usuarios</p>
      </div>
      <div class="header-actions">
        <button id="exportUsersBtn" class="btn-secondary" title="Exportar CSV">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Exportar
        </button>
        <button id="sendBulkNewsletterBtn" class="btn-primary" title="Enviar newsletter">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          Enviar a Todos
        </button>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-mini">
        <div class="stat-mini-icon violet">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-mini-content">
          <span class="stat-mini-value">{totalUsers}</span>
          <span class="stat-mini-label">Total</span>
        </div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-icon emerald">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-mini-content">
          <span class="stat-mini-value">{activeRecentCount}</span>
          <span class="stat-mini-label">Activos 30d</span>
        </div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-icon sky">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <div class="stat-mini-content">
          <span class="stat-mini-value">{subscribedCount}<span class="stat-mini-total">/{totalUsers}</span></span>
          <span class="stat-mini-label">Suscritos</span>
        </div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-icon amber">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20v-6M6 20V10M18 20V4"/></svg>
        </div>
        <div class="stat-mini-content">
          <span class="stat-mini-value">+{newThisWeek}</span>
          <span class="stat-mini-label">Nuevos 7d</span>
        </div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-icon pink">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-mini-content">
          <span class="stat-mini-value">{formatTime(totalListeningTime)}</span>
          <span class="stat-mini-label">Tiempo Total</span>
        </div>
      </div>
    </div>

    <div class="filters-bar">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="searchInput" placeholder="Buscar por nombre, email o ID..." />
      </div>
      <select id="filterRole" class="filter-select">
        <option value="all">Todos los roles</option>
        <option value="user">Usuarios</option>
        <option value="admin">Admins</option>
        <option value="owner">Owners</option>
      </select>
      <select id="filterNewsletter" class="filter-select">
        <option value="all">Newsletter: Todos</option>
        <option value="subscribed">Suscritos</option>
        <option value="unsubscribed">No suscritos</option>
      </select>
      <select id="sortBy" class="filter-select">
        <option value="newest">Más recientes</option>
        <option value="oldest">Más antiguos</option>
        <option value="name">Nombre A-Z</option>
        <option value="listening">Más escuchado</option>
      </select>
      <div id="resultsCounter" class="results-count">
        <span id="resultsCount">{totalUsers}</span> usuarios
      </div>
    </div>

    <div class="table-card">
      <table class="users-table">
        <thead>
          <tr>
            <th class="th-checkbox"><input type="checkbox" id="selectAllUsers" /></th>
            <th>Usuario</th>
            <th class="hide-mobile">Email</th>
            <th class="th-center">Rol</th>
            <th class="th-center hide-mobile">Registro</th>
            <th class="th-center hide-tablet">Actividad</th>
            <th class="hide-tablet">Progreso</th>
            <th class="th-actions">Acciones</th>
          </tr>
        </thead>
        <tbody id="usersListContainer">
          {users.map((user) => {
            const isCurrentUser = user._id.toString() === currentUser._id.toString();
            const daysAgo = user.lastActiveAt ? Math.floor((now.getTime() - new Date(user.lastActiveAt).getTime()) / (1000 * 60 * 60 * 24)) : -1;
            const isActive = daysAgo >= 0 && 7 >= daysAgo;
            const isInactive = daysAgo >= 31 || daysAgo === -1;
            return (
              <tr class="user-row"
                data-id={user._id}
                data-name={user.name.toLowerCase()}
                data-email={user.email.toLowerCase()}
                data-role={user.role}
                data-newsletter={user.newsletter ? 'subscribed' : 'unsubscribed'}
                data-created={new Date(user.createdAt).getTime()}
                data-listening={user.listeningTime || 0}
                data-streak={user.currentStreak || 0}
                data-last-active={user.lastActiveAt ? new Date(user.lastActiveAt).getTime() : 0}
              >
                <td class="td-checkbox"><input type="checkbox" class="user-checkbox" data-id={user._id} /></td>
                <td class="td-user">
                  <div class="user-cell">
                    <div class="avatar-wrap">
                      <img src={user.picture || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=7c3aed&color=fff&size=80`} alt={user.name} class="avatar" />
                      <span class={`status-dot ${isActive ? 'active' : isInactive ? 'inactive' : 'away'}`}></span>
                    </div>
                    <div class="user-info">
                      <span class="user-name">{user.name}{isCurrentUser && <span class="you-badge">TÚ</span>}</span>
                      <span class="user-email">{user.email}</span>
                    </div>
                  </div>
                </td>
                <td class="hide-mobile td-email">{user.email}</td>
                <td class="td-center">
                  <span class={`role-badge ${user.role}`}>{user.role}</span>
                </td>
                <td class="td-center hide-mobile td-date">
                  {new Date(user.createdAt).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: '2-digit' })}
                </td>
                <td class="td-center hide-tablet">
                  <span class={`activity-status ${isActive ? 'active' : isInactive ? 'inactive' : ''}`}>
                    {daysAgo === 0 ? 'Hoy' : daysAgo > 0 ? `Hace ${daysAgo}d` : 'Nunca'}
                  </span>
                  {(user.currentStreak || 0) > 0 && <span class="streak-badge">{user.currentStreak}d</span>}
                </td>
                <td class="hide-tablet td-progress">
                  <div class="progress-wrap">
                    <span class="progress-time">{formatTime(user.listeningTime || 0)}</span>
                    <div class="progress-bar"><div class="progress-fill" style={`width: ${Math.min(100, ((user.listeningTime || 0) / (Math.max(1, avgListeningTime) * 2)) * 100)}%`}></div></div>
                  </div>
                </td>
                <td class="td-actions">
                  <div class="action-buttons">
                    <button class="action-btn view-btn" data-user={JSON.stringify(user)} title="Ver">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 12 10 10 10-10-10-10Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                    <button class="action-btn edit-btn" data-user={JSON.stringify(user)} title="Editar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                    <button class="action-btn audit-btn" data-user={JSON.stringify(user)} title="Auditoría">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </button>
                    {!isCurrentUser && (
                      <button class="action-btn delete-btn" data-id={user._id} title="Eliminar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div id="noResults" class="no-results">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <h3>No hay resultados</h3>
        <p>Ajusta los filtros para encontrar lo que buscas.</p>
      </div>
    </div>

    <div id="bulkActionsBar" class="bulk-bar">
      <span id="selectedCount" class="bulk-count">0</span>
      <span class="bulk-label">Seleccionados</span>
      <button id="bulkDeleteBtn" class="bulk-action danger">Eliminar</button>
      <button id="cancelBulk" class="bulk-cancel">&times;</button>
    </div>
  </div>

  <div id="editUserModal" class="modal" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Editar Usuario</h3>
        <button class="modal-close" data-close="editUserModal">&times;</button>
      </div>
      <form id="editUserForm">
        <input type="hidden" id="editUserId" name="userId" />
        <div class="form-grid">
          <div class="form-group">
            <label>Nombre</label>
            <input type="text" id="editName" name="name" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" id="editEmail" name="email" required />
          </div>
        </div>
        <div class="form-group">
          <label>Bio</label>
          <textarea id="editBio" name="bio" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label>Rol</label>
          <select id="editRole" name="role">
            <option value="user">Usuario</option>
            <option value="admin">Administrador</option>
            <option value="owner">Dueño</option>
          </select>
        </div>
        <div class="form-group">
          <label>Tiempo Escuchado</label>
          <div class="time-inputs">
            <input type="number" id="editListeningHours" placeholder="0" min="0" /><span>H</span>
            <input type="number" id="editListeningMinutes" placeholder="0" min="0" max="59" /><span>M</span>
            <input type="number" id="editListeningSeconds" placeholder="0" min="0" max="59" /><span>S</span>
          </div>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="editNewsletter" name="newsletter" />
            <span>Suscrito a la Newsletter</span>
          </label>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-cancel" data-close="editUserModal">Cancelar</button>
          <button type="submit" class="btn-save">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <div id="confirmModal" class="modal" style="display:none;">
    <div class="modal-content modal-sm">
      <h3 id="confirmTitle">Confirmar Acción</h3>
      <p id="confirmMessage"></p>
      <div class="form-actions">
        <button type="button" class="btn-cancel" data-close="confirmModal">Cancelar</button>
        <button type="button" id="executeConfirm" class="btn-danger">Confirmar</button>
      </div>
    </div>
  </div>

  <script>
    declare global {
      interface Window {
        customConfirm: (title: string, message: string, callback: () => void) => void;
      }
    }

    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterRole = document.getElementById('filterRole') as HTMLSelectElement;
    const filterNewsletter = document.getElementById('filterNewsletter') as HTMLSelectElement;
    const sortBy = document.getElementById('sortBy') as HTMLSelectElement;
    const resultsCount = document.getElementById('resultsCount');
    const noResults = document.getElementById('noResults');
    const container = document.getElementById('usersListContainer');

    function applyFilters() {
      if (!container) return;
      const rows = container.querySelectorAll('.user-row') as NodeListOf<HTMLElement>;
      const query = searchInput?.value.toLowerCase() || '';
      const roleFilter = filterRole?.value || 'all';
      const newsletterFilter = filterNewsletter?.value || 'all';
      const sort = sortBy?.value || 'newest';

      let visibleRows: HTMLElement[] = [];

      rows.forEach(row => {
        const name = row.dataset.name || '';
        const email = row.dataset.email || '';
        const role = row.dataset.role || '';
        const newsletter = row.dataset.newsletter || '';

        let visible = true;
        if (query && !name.includes(query) && !email.includes(query)) visible = false;
        if (roleFilter !== 'all' && role !== roleFilter) visible = false;
        if (newsletterFilter !== 'all' && newsletter !== newsletterFilter) visible = false;

        row.style.display = visible ? '' : 'none';
        if (visible) visibleRows.push(row);
      });

      visibleRows.sort((a, b) => {
        switch (sort) {
          case 'oldest': return Number(a.dataset.created) - Number(b.dataset.created);
          case 'newest': return Number(b.dataset.created) - Number(a.dataset.created);
          case 'name': return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          case 'listening': return Number(b.dataset.listening) - Number(a.dataset.listening);
          default: return 0;
        }
      });

      visibleRows.forEach(row => container.appendChild(row));

      if (resultsCount) resultsCount.textContent = visibleRows.length.toString();
      if (noResults) noResults.style.display = visibleRows.length === 0 ? 'block' : 'none';
    }

    searchInput?.addEventListener('input', applyFilters);
    filterRole?.addEventListener('change', applyFilters);
    filterNewsletter?.addEventListener('change', applyFilters);
    sortBy?.addEventListener('change', applyFilters);

    let confirmCallback: (() => void) | null = null;
    window.customConfirm = (title: string, message: string, callback: () => void) => {
      const titleEl = document.getElementById('confirmTitle');
      const msgEl = document.getElementById('confirmMessage');
      if (titleEl) titleEl.innerText = title;
      if (msgEl) msgEl.innerText = message;
      confirmCallback = callback;
      const modal = document.getElementById('confirmModal');
      if (modal) modal.style.display = 'flex';
    };

    document.getElementById('executeConfirm')?.addEventListener('click', () => {
      if (confirmCallback) confirmCallback();
      const modal = document.getElementById('confirmModal');
      if (modal) modal.style.display = 'none';
    });

    document.querySelectorAll('[data-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = (btn as HTMLElement).dataset.close;
        const modal = document.getElementById(modalId || '');
        if (modal) modal.style.display = 'none';
      });
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const userData = JSON.parse(target.dataset.user || '{}');
        (document.getElementById('editUserId') as HTMLInputElement).value = userData._id;
        (document.getElementById('editName') as HTMLInputElement).value = userData.name;
        (document.getElementById('editEmail') as HTMLInputElement).value = userData.email;
        (document.getElementById('editBio') as HTMLTextAreaElement).value = userData.bio || '';
        (document.getElementById('editRole') as HTMLSelectElement).value = userData.role;
        const totalSeconds = userData.listeningTime || 0;
        (document.getElementById('editListeningHours') as HTMLInputElement).value = Math.floor(totalSeconds / 3600).toString();
        (document.getElementById('editListeningMinutes') as HTMLInputElement).value = Math.floor((totalSeconds % 3600) / 60).toString();
        (document.getElementById('editListeningSeconds') as HTMLInputElement).value = (totalSeconds % 60).toString();
        (document.getElementById('editNewsletter') as HTMLInputElement).checked = !!userData.newsletter;
        const modal = document.getElementById('editUserModal');
        if (modal) modal.style.display = 'flex';
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const userId = target.dataset.id;
        window.customConfirm('Eliminar Usuario', '¿Estás seguro de que quieres eliminar este usuario? Esta acción no se puede deshacer.', async () => {
          try {
            const res = await fetch(`/api/admin/users?id=${userId}`, { method: 'DELETE' });
            if (res.ok) window.location.reload();
          } catch (err) { console.error(err); }
        });
      });
    });
  </script>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin: 0;
  }

  .subtitle {
    color: #71717a;
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border: none;
    border-radius: 10px;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.4);
  }

  .btn-secondary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #a1a1aa;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .stats-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .stat-mini {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    flex-shrink: 0;
    min-width: 140px;
  }

  .stat-mini-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-mini-icon.violet { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }
  .stat-mini-icon.emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; }
