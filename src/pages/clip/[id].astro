---
import Layout from '@/layouts/Layout.astro';
import ClipsFeed from '@/components/ClipsFeed.astro';

export const prerender = false;

const { id } = Astro.params;

// Cache for 30 minutes. The shuffle will be the same for all users during the cache lifetime.
Astro.response.headers.set('Cache-Control', 's-maxage=1800, stale-while-revalidate=900');
---

<Layout title="Clips" description="Los mejores momentos de Veredillas FM en formato corto.">
  <ClipsFeed initialWatchId={id} />
</Layout>
