</style>

<!-- Global styles for dynamically generated elements -->
<style is:global>
  .grid-clip-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: white;
    border-radius: 10px;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .grid-clip-card:hover {
    border-color: rgba(139, 92, 246, 0.4);
    transform: translateY(-3px) scale(1.03);
  }

  .grid-clip-card img {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  .grid-clip-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 0.5rem 0.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, transparent 100%);
  }

  .grid-clip-title {
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    const WIN = window;
    const BATCH_SIZE = 10;

    const rawClips = WIN._initialClips || [];
    let currentPool = [];
    let renderedCount = 0;
    let currentFilter = 'all';
    let likedClipIds = new Set();
    let modalClipIndex = -1;
    let ytPlayer = null;
    let ytApiReady = false;

    // Helper: Escapes HTML strings
    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Helper: Fisher-Yates Shuffle
    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    // --- YOUTUBE API SETUP ---
    if (!WIN.YT) {
      if (!document.getElementById('yt-api-script')) {
        const tag = document.createElement('script');
        tag.id = 'yt-api-script';
        tag.src = 'https://www.youtube.com/iframe_api';
        const first = document.getElementsByTagName('script')[0];
        first?.parentNode?.insertBefore(tag, first);
      }

      WIN.onYouTubeIframeAPIReady = function () {
        ytApiReady = true;
      };
    } else {
      ytApiReady = true;
    }

    // Prepare shuffled pool based on filter
    function preparePool(filter = 'all') {
      currentFilter = filter;
      let filtered = rawClips;
      if (filter !== 'all') {
        filtered = rawClips.filter((c) => c.episodeSlug === filter);
      }
      currentPool = shuffleArray(filtered);
      renderedCount = 0;
    }

    // Create DOM element for clip card
    function createClipCard(clip, index) {
      const card = document.createElement('div');
      card.className = 'clip-card animate-card-in';
      card.setAttribute('data-video-id', clip.videoId);
      card.setAttribute('data-episode-slug', clip.episodeSlug);

      const isLiked = likedClipIds.has(clip.videoId);

      card.innerHTML = `
        <div class="clip-card-media" onclick="window.openCinemaModal('${clip.videoId}')">
          <img class="clip-card-thumb" src="${clip.thumbnail}" alt="" loading="lazy" />
          <div class="clip-card-sheen" aria-hidden="true"></div>
          <span class="clip-card-episode-tag">${escapeHtml(clip.episodeTitle)}</span>
          <div class="clip-card-play">
            <div class="clip-card-play-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            </div>
          </div>
        </div>

        <div class="clip-card-info">
          <h3 class="clip-card-title" onclick="window.openCinemaModal('${clip.videoId}')">${escapeHtml(clip.title)}</h3>
          
          <div class="clip-card-actions">
            <button class="clip-action-btn like-btn ${isLiked ? 'liked' : ''}" data-clip-id="${clip.videoId}" onclick="window.handleLikeClip(this, event)" aria-label="Me gusta">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="${isLiked ? '#ef4444' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </button>

            <button class="clip-action-btn share-btn" data-clip-id="${clip.videoId}" onclick="window.handleShareClip(this, event)" aria-label="Compartir">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            </button>

            <button class="clip-action-btn watch-btn" onclick="window.openCinemaModal('${clip.videoId}')" aria-label="Ver clip">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            </button>
          </div>
        </div>
      `;

      return card;
    }

    // Render batch of cards
    function renderNextBatch() {
      const grid = document.getElementById('clips-grid');
      const sentinel = document.getElementById('infinite-scroll-sentinel');
      const endMsg = document.getElementById('clips-end-msg');
      if (!grid) return;

      if (renderedCount >= currentPool.length) {
        if (sentinel) sentinel.style.display = 'none';
        if (endMsg && currentPool.length > 0) endMsg.style.display = 'flex';
        return;
      }

      const nextBatch = currentPool.slice(renderedCount, renderedCount + BATCH_SIZE);
      const fragment = document.createDocumentFragment();

      nextBatch.forEach((clip, i) => {
        const card = createClipCard(clip, renderedCount + i);
        fragment.appendChild(card);
      });

      grid.appendChild(fragment);
      renderedCount += nextBatch.length;

      const countDisplay = document.getElementById('clips-count-display');
      if (countDisplay) {
        countDisplay.textContent = `${renderedCount} de ${currentPool.length} clips`;
      }

      if (renderedCount >= currentPool.length) {
        if (sentinel) sentinel.style.display = 'none';
        if (endMsg) endMsg.style.display = 'flex';
      } else {
        if (sentinel) sentinel.style.display = 'flex';
        if (endMsg) endMsg.style.display = 'none';
      }
    }

    // Reshuffle grid
    WIN.reshuffleGrid = function () {
      const grid = document.getElementById('clips-grid');
      const endMsg = document.getElementById('clips-end-msg');
      if (grid) grid.innerHTML = '';
      if (endMsg) endMsg.style.display = 'none';

      const icon = document.getElementById('shuffle-btn-icon');
      if (icon) {
        icon.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }], { duration: 500 });
      }

      preparePool(currentFilter);
      renderNextBatch();
      WIN.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Infinite Scroll IntersectionObserver
    let infiniteObserver = null;
    function setupInfiniteScroll() {
      const sentinel = document.getElementById('infinite-scroll-sentinel');
      if (!sentinel) return;

      if (infiniteObserver) infiniteObserver.disconnect();
      infiniteObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              renderNextBatch();
            }
          });
        },
        { rootMargin: '250px 0px' }
      );

      infiniteObserver.observe(sentinel);
    }

    // Toast Notification helper
    function showToast(message) {
      const toast = document.getElementById('toast-notification');
      const msgEl = document.getElementById('toast-message');
      if (!toast || !msgEl) return;

      msgEl.textContent = message;
      toast.classList.add('active');
      setTimeout(() => {
        toast.classList.remove('active');
      }, 2500);
    }

    // --- CINEMA MODAL LOGIC ---
    WIN.openCinemaModal = function (videoId) {
      let index = currentPool.findIndex((c) => c.videoId === videoId);
      if (index === -1) {
        index = rawClips.findIndex((c) => c.videoId === videoId);
        if (index !== -1) {
          modalClipIndex = index;
          renderModalContent(rawClips[index]);
        }
      } else {
        modalClipIndex = index;
        renderModalContent(currentPool[index]);
      }

      const modal = document.getElementById('clip-cinema-modal');
      if (modal) {
        document.body.classList.add('cinema-modal-open');
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
      }

      const url = new URL(WIN.location.href);
      url.searchParams.set('watch', videoId);
      WIN.history.replaceState({}, '', url);
    };

    WIN.closeCinemaModal = function () {
      const modal = document.getElementById('clip-cinema-modal');
      const wrapper = document.getElementById('modal-player-wrapper');
      if (modal) {
        document.body.classList.remove('cinema-modal-open');
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
      }

      if (wrapper) wrapper.innerHTML = '';
      if (ytPlayer && typeof ytPlayer.destroy === 'function') {
        try { ytPlayer.destroy(); } catch(e) {}
        ytPlayer = null;
      }

      const url = new URL(WIN.location.href);
      url.searchParams.delete('watch');
      WIN.history.replaceState({}, '', url);
    };

    function renderModalContent(clip) {
      if (!clip) return;

      const titleEl = document.getElementById('modal-clip-title');
      const epTitleEl = document.getElementById('modal-episode-title');
      const epLinkEl = document.getElementById('modal-episode-link');
      const queueEl = document.getElementById('modal-queue-indicator');
      const likeBtn = document.getElementById('modal-like-btn');
      const wrapper = document.getElementById('modal-player-wrapper');

      if (titleEl) titleEl.textContent = clip.title;
      if (epTitleEl) epTitleEl.textContent = clip.episodeTitle;
      if (epLinkEl) epLinkEl.href = `/ep/${clip.episodeSlug}`;

      const total = currentPool.length || rawClips.length;
      const displayIndex = modalClipIndex >= 0 ? modalClipIndex + 1 : 1;
      if (queueEl) queueEl.textContent = `${displayIndex} / ${total}`;

      const isLiked = likedClipIds.has(clip.videoId);
      if (likeBtn) {
        likeBtn.classList.toggle('liked', isLiked);
        likeBtn.setAttribute('data-clip-id', clip.videoId);
      }

      if (!wrapper) return;
      wrapper.innerHTML = '';

      if (clip.playbackKind === 'youtube') {
        const playerDiv = document.createElement('div');
        playerDiv.id = 'modal-yt-player';
        wrapper.appendChild(playerDiv);

        if (WIN.YT && WIN.YT.Player) {
          ytPlayer = new WIN.YT.Player('modal-yt-player', {
            height: '100%',
            width: '100%',
            videoId: clip.mediaSrc,
            playerVars: {
              autoplay: 1,
              playsinline: 1,
              controls: 1,
              rel: 0,
              modestbranding: 1,
              origin: WIN.location.origin,
            },
          });
        } else {
          playerDiv.innerHTML = `<iframe width="100%" height="100%" src="https://www.youtube.com/embed/${clip.mediaSrc}?autoplay=1&playsinline=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        }
      } else {
        const video = document.createElement('video');
        video.src = clip.mediaSrc;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.style.width = '100%';
        video.style.height = '100%';
        video.style.objectFit = 'cover';
        wrapper.appendChild(video);
      }
    }

    WIN.navigateCinemaModal = function (direction) {
      const list = currentPool.length > 0 ? currentPool : rawClips;
      if (list.length === 0) return;

      modalClipIndex = (modalClipIndex + direction + list.length) % list.length;
      const nextClip = list[modalClipIndex];
      renderModalContent(nextClip);

      const url = new URL(WIN.location.href);
      url.searchParams.set('watch', nextClip.videoId);
      WIN.history.replaceState({}, '', url);
    };

    WIN.toggleModalPlayback = function () {
      const wrapper = document.getElementById('modal-player-wrapper');
      const video = wrapper?.querySelector('video');
      if (video) {
        if (video.paused) video.play();
        else video.pause();
      }
    };

    WIN.handleModalLike = function () {
      const likeBtn = document.getElementById('modal-like-btn');
      if (!likeBtn) return;
      WIN.handleLikeClip(likeBtn);
    };

    WIN.handleModalShare = function () {
      const currentClip = currentPool[modalClipIndex] || rawClips[modalClipIndex];
      if (!currentClip) return;
      const url = new URL(WIN.location.href);
      url.searchParams.set('watch', currentClip.videoId);

      navigator.clipboard.writeText(url.toString()).then(() => {
        showToast('🔗 ¡Enlace copiado al portapapeles!');
      });
    };

    WIN.handleModalOpenDrawer = function () {
      const currentClip = currentPool[modalClipIndex] || rawClips[modalClipIndex];
      if (!currentClip) return;
      const dummyBtn = document.createElement('button');
      dummyBtn.setAttribute('data-episode-slug', currentClip.episodeSlug);
      WIN.handleOpenEpisodeClips(dummyBtn);
    };

    // --- ACTIONS: LIKE & SHARE ---
    WIN.handleLikeClip = async function (btn, event) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }

      const clipId = btn.getAttribute('data-clip-id');
      if (!clipId) return;

      const isLiked = btn.classList.contains('liked');

      if (isLiked) {
        btn.classList.remove('liked');
        likedClipIds.delete(clipId);
        btn.querySelector('svg')?.setAttribute('fill', 'none');
      } else {
        btn.classList.add('liked');
        likedClipIds.add(clipId);
        btn.querySelector('svg')?.setAttribute('fill', '#ef4444');
        btn.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.3)' }, { transform: 'scale(1)' }], { duration: 200 });
      }

      // Sync other buttons for same clipId
      document.querySelectorAll(`.like-btn[data-clip-id="${clipId}"]`).forEach((other) => {
        if (other !== btn) {
          other.classList.toggle('liked', !isLiked);
          other.querySelector('svg')?.setAttribute('fill', !isLiked ? '#ef4444' : 'none');
        }
      });

      try {
        const res = await fetch('/api/clips/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clipId }),
        });
        if (res.status === 401) {
          showToast('🔒 Inicia sesión para guardar me gustas');
        }
      } catch (e) {
        console.error(e);
      }
    };

    WIN.handleShareClip = function (btn, event) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }
      const clipId = btn.getAttribute('data-clip-id');
      const url = new URL(WIN.location.href);
      if (clipId) url.searchParams.set('watch', clipId);

      navigator.clipboard.writeText(url.toString()).then(() => {
        showToast('🔗 ¡Enlace del clip copiado!');
      });
    };

    // --- EPISODE CLIPS SIDE DRAWER ---
    WIN.handleOpenEpisodeClips = function (btn) {
      const slug = btn.getAttribute('data-episode-slug');
      if (!slug || !WIN._clipsByEpisode) return;

      const episodeData = WIN._clipsByEpisode[slug];
      if (!episodeData || !episodeData.clips || episodeData.clips.length === 0) return;

      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      const grid = document.getElementById('panel-clips-grid');
      const titleEl = document.getElementById('panel-episode-title');
      const imageEl = document.getElementById('panel-episode-image');
      const countEl = document.getElementById('panel-clips-count');
      if (!panel || !grid || !titleEl || !imageEl || !countEl || !backdrop) return;

      const currentWatch = new URLSearchParams(WIN.location.search).get('watch');

      titleEl.textContent = episodeData.episodeTitle;
      imageEl.src = episodeData.episodeImage;
      imageEl.alt = episodeData.episodeTitle;
      countEl.textContent = '🎬 ' + episodeData.clips.length + ' clips';

      grid.innerHTML = episodeData.clips
        .map((clip, i) => {
          const isActive = clip.videoId === currentWatch;
          return (
            '<div class="grid-clip-card' + (isActive ? ' active-clip' : '') + '" onclick="window.openCinemaModal(\'' + (clip.videoId || '') + '\')">' +
            '<img src="' + (clip.thumbnail || '') + '" alt="" loading="lazy" />' +
            '<div class="grid-clip-info"><div class="grid-clip-title">' + escapeHtml(clip.title) + '</div></div>' +
            '</div>'
          );
        })
        .join('');

      panel.classList.add('active');
      backdrop.classList.add('active');
    };

    WIN.handleCloseEpisodeClips = function () {
      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      if (panel) panel.classList.remove('active');
      if (backdrop) backdrop.classList.remove('active');
    };

    // Load liked clips from backend
    async function loadLikes() {
      try {
        const res = await fetch('/api/clips/liked');
        if (res.ok) {
          const data = await res.json();
          const liked = data.likedClips || [];
          likedClipIds = new Set(liked);
          document.querySelectorAll('.like-btn').forEach((btn) => {
            const cid = btn.getAttribute('data-clip-id');
            if (cid && likedClipIds.has(cid)) {
              btn.classList.add('liked');
              btn.querySelector('svg')?.setAttribute('fill', '#ef4444');
            }
          });
        }
      } catch (e) {
        console.error(e);
      }
    }

    // Filter Chips Wiring
    function initFilters() {
      document.querySelectorAll('.clips-filter-chip').forEach((chip) => {
        chip.onclick = () => {
          document.querySelectorAll('.clips-filter-chip').forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          const filter = chip.getAttribute('data-filter') || 'all';

          const grid = document.getElementById('clips-grid');
          if (grid) grid.innerHTML = '';
          preparePool(filter);
          renderNextBatch();
        };
      });

      const shuffleBtn = document.getElementById('shuffle-feed-btn');
      if (shuffleBtn) {
        shuffleBtn.onclick = () => WIN.reshuffleGrid();
      }
    }

    // Keyboard Shortcuts (Esc to close, Left/Right arrows to navigate modal)
    document.addEventListener('keydown', function (e) {
      const modal = document.getElementById('clip-cinema-modal');
      const panel = document.getElementById('episode-clips-panel');

      if (e.key === 'Escape') {
        if (panel && panel.classList.contains('active')) {
          WIN.handleCloseEpisodeClips();
          return;
        }
        if (modal && modal.classList.contains('active')) {
          WIN.closeCinemaModal();
          return;
        }
      }

      if (modal && modal.classList.contains('active')) {
        if (e.key === 'ArrowLeft') WIN.navigateCinemaModal(-1);
        if (e.key === 'ArrowRight') WIN.navigateCinemaModal(1);
      }
    });

    // INIT
    function initPage() {
      if (!document.getElementById('clips-grid')) return;

      preparePool('all');
      renderNextBatch();
      setupInfiniteScroll();
      initFilters();
      loadLikes();

      const watchId = new URLSearchParams(WIN.location.search).get('watch');
      if (watchId) {
        WIN.openCinemaModal(watchId);
      }
    }

    if (!WIN._clipsPageLoadRegistered) {
      WIN._clipsPageLoadRegistered = true;
      document.addEventListener('astro:page-load', initPage);
    }

    initPage();
  })();
</script>
