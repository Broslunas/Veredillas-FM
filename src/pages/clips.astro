---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from '@/lib/content';
import { resolveClipVideoId, resolveClipThumbnail, resolveClipPlayback } from '@/lib/clips';

export const prerender = false;

const allEpisodes = await getCollection('episodios');

// Flatten every episode's clips into a single gallery feed
let clips = allEpisodes
  .flatMap((episode) => {
    return (episode.data.clips || []).map((clip: any) => {
      const videoId = resolveClipVideoId(clip);
      const playback = resolveClipPlayback(clip);
      return {
        title: clip.title,
        videoId,
        thumbnail: resolveClipThumbnail(clip),
        playbackKind: playback.kind,
        mediaSrc: playback.kind === 'youtube' ? playback.videoId || '' : playback.url,
        episodeTitle: episode.data.title,
        episodeSlug: episode.slug,
        episodeImage:
          typeof episode.data.image === 'string' ? episode.data.image : episode.data.image?.src || '/placeholder.jpg',
      };
    });
  })
  .filter((clip) => clip.videoId);

// Build a map of clips grouped by episode slug for the side panel
const clipsByEpisode: Record<
  string,
  { episodeTitle: string; episodeImage: string; clips: Array<{ title: string; videoId: string; thumbnail: string }> }
> = {};

allEpisodes.forEach((episode) => {
  const epClips = (episode.data.clips || [])
    .map((clip: any) => ({ title: clip.title, videoId: resolveClipVideoId(clip), thumbnail: resolveClipThumbnail(clip) }))
    .filter((c: any) => c.videoId);
  if (epClips.length > 0) {
    clipsByEpisode[episode.slug] = {
      episodeTitle: episode.data.title,
      episodeImage:
        typeof episode.data.image === 'string' ? episode.data.image : episode.data.image?.src || '/placeholder.jpg',
      clips: epClips,
    };
  }
});

// Distinct episodes represented in the feed for the filter row
const seenSlugs = new Set<string>();
const episodeOptions = clips
  .filter((c) => {
    if (seenSlugs.has(c.episodeSlug)) return false;
    seenSlugs.add(c.episodeSlug);
    return true;
  })
  .map((c) => ({ slug: c.episodeSlug, title: c.episodeTitle }));

Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
---

<Layout title="Clips & Momentos" description="Explora todos los momentos destacados de Veredillas FM en formato vídeo.">
  <section class="clips-hero">
    <div class="clips-bg-glow" aria-hidden="true"></div>

    <div class="clips-hero-inner">
      <div class="clips-eyebrow">
        <span class="clips-eyebrow-dot"></span>
        Galería Interactiva
      </div>
      <div class="clips-title-row">
        <h1 class="clips-title">Clips & Momentos</h1>
        <span id="clips-count-display" class="clips-count-chip">{clips.length} clips</span>
      </div>
      <p class="clips-subtitle">Los mejores momentos de Veredillas FM en formato corto. Descubre clips aleatorios a medida que exploras.</p>
    </div>

    <div class="clips-toolbar">
      <!-- Shuffle Feed Button -->
      <button id="shuffle-feed-btn" class="clips-btn clips-btn-primary" aria-label="Mezclar clips aleatoriamente">
        <svg id="shuffle-btn-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>Mezclar Aleatorio</span>
      </button>

      <!-- Episode Filter Chips -->
      {episodeOptions.length > 0 && (
        <div class="ep-chip-row clips-filter-row" id="clips-filter-row">
          <button class="ep-chip clips-filter-chip is-active" data-filter="all">Todos</button>
          {episodeOptions.map((ep) => (
            <button class="ep-chip clips-filter-chip" data-filter={ep.slug}>{ep.title}</button>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Infinite Scroll Gallery Grid -->
  <section class="clips-grid-section">
    <div class="clips-grid" id="clips-grid">
      <!-- Populated dynamically via JS batch by batch -->
    </div>

    <!-- Infinite Scroll Sentinel & Loading Indicator -->
    <div id="infinite-scroll-sentinel" class="infinite-sentinel">
      <div class="sentinel-loader">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>
      <span class="sentinel-text">Cargando más clips...</span>
    </div>

    <!-- End of Feed Message -->
    <div id="clips-end-msg" class="clips-end-msg" style="display: none;">
      <p>✨ Has explorado todos los clips de esta lista.</p>
      <button class="clips-btn clips-btn-secondary" onclick="window.reshuffleGrid()">
        🎲 Volver a mezclar todo
      </button>
    </div>
  </section>

  <!-- Cinema Lightbox Theater Modal (Non-TikTok Player) -->
  <div id="clip-cinema-modal" class="cinema-modal" aria-hidden="true">
    <div class="cinema-backdrop" onclick="window.closeCinemaModal()"></div>

    <div class="cinema-dialog">
      <!-- Header -->
      <div class="cinema-header">
        <div class="cinema-meta">
          <a id="modal-episode-link" href="#" class="cinema-ep-chip">
            <span class="cinema-ep-icon">🎙️</span>
            <span id="modal-episode-title">Episodio</span>
          </a>
          <h2 id="modal-clip-title" class="cinema-title">Título del clip</h2>
        </div>

        <button class="cinema-close-btn" onclick="window.closeCinemaModal()" aria-label="Cerrar reproductor">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Media Stage -->
      <div class="cinema-stage">
        <div class="cinema-video-container">
          <div id="modal-player-wrapper" class="modal-player-wrapper">
            <!-- Dynamically populated player iframe / video -->
          </div>
          <div id="modal-interaction-layer" class="modal-interaction-layer" onclick="window.toggleModalPlayback()"></div>
        </div>
      </div>

      <!-- Footer Controls & Actions -->
      <div class="cinema-footer">
        <div class="cinema-nav-controls">
          <button class="cinema-nav-btn" onclick="window.navigateCinemaModal(-1)" aria-label="Clip anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Anterior
          </button>

          <span id="modal-queue-indicator" class="cinema-queue-indicator">1 / 10</span>

          <button class="cinema-nav-btn" onclick="window.navigateCinemaModal(1)" aria-label="Siguiente clip">
            Siguiente
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>

        <div class="cinema-action-bar">
          <button id="modal-like-btn" class="cinema-action-btn like-btn" onclick="window.handleModalLike()" aria-label="Me gusta">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span class="btn-label">Me gusta</span>
          </button>

          <button id="modal-share-btn" class="cinema-action-btn share-btn" onclick="window.handleModalShare()" aria-label="Compartir">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            <span class="btn-label">Compartir</span>
          </button>

          <button id="modal-ep-drawer-btn" class="cinema-action-btn drawer-btn" onclick="window.handleModalOpenDrawer()" aria-label="Ver clips del episodio">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span class="btn-label">Clips del episodio</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Episode Clips Side Panel Drawer -->
  <div id="episode-panel-backdrop" class="panel-backdrop" onclick="window.handleCloseEpisodeClips()"></div>
  <aside id="episode-clips-panel" class="episode-clips-panel">
    <div class="panel-header">
      <button class="panel-close-btn" onclick="window.handleCloseEpisodeClips()" aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="panel-episode-hero">
      <img id="panel-episode-image" class="panel-episode-cover" src="" alt="" />
      <div class="panel-episode-meta">
        <h3 id="panel-episode-title" class="panel-episode-title">Episodio</h3>
        <span id="panel-clips-count" class="panel-clips-count"></span>
      </div>
    </div>
    <div id="panel-clips-grid" class="panel-clips-grid">
      <!-- Populated dynamically -->
    </div>
  </aside>

  <!-- Toast Toasting Notification -->
  <div id="toast-notification" class="toast-notification" aria-live="polite">
    <span id="toast-message"></span>
  </div>

  <!-- Inject clips data into JS -->
  <script is:inline define:vars={{ initialClips: clips, clipsByEpisode }}>
    window._initialClips = initialClips;
    window._clipsByEpisode = clipsByEpisode;
  </script>
</Layout>

<style>
  :global(body.cinema-modal-open) {
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════════════════════ */
  /* Hero & Toolbar Section                                      */
  /* ═══════════════════════════════════════════════════════════ */

  .clips-hero {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1.5rem 1.5rem;
    overflow: hidden;
  }

  .clips-bg-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .clips-bg-glow::before,
  .clips-bg-glow::after {
    content: '';
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.22;
  }

  .clips-bg-glow::before {
    top: -220px;
    left: -120px;
    background: var(--color-primary, #8b5cf6);
  }

  .clips-bg-glow::after {
    top: -160px;
    right: -160px;
    background: var(--color-accent, #ec4899);
  }

  .clips-hero-inner {
    margin-bottom: 1.5rem;
  }

  .clips-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-primary, #8b5cf6);
    font-weight: 900;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 1rem;
  }

  .clips-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary, #8b5cf6);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.6);
  }

  .clips-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .clips-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    color: var(--color-text-main, #ffffff);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 0.75rem;
    text-shadow: 0 0 60px rgba(139, 92, 246, 0.25);
  }

  .clips-count-chip {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.9rem;
    margin-bottom: 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.75rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.7);
  }

  .clips-subtitle {
    color: rgba(255, 255, 255, 0.65);
    font-size: 1.05rem;
    max-width: 50ch;
    line-height: 1.5;
  }

  .clips-toolbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .clips-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    border: none;
    outline: none;
  }

  .clips-btn-primary {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.9), rgba(236, 72, 153, 0.85));
    color: white;
    box-shadow: 0 8px 24px -6px rgba(139, 92, 246, 0.5);
  }

  .clips-btn-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 30px -6px rgba(139, 92, 246, 0.7);
    background: linear-gradient(135deg, rgba(139, 92, 246, 1), rgba(236, 72, 153, 0.95));
  }

  .clips-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
  }

  .clips-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .clips-filter-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, black 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, black 90%, transparent);
  }

  .clips-filter-row::-webkit-scrollbar {
    display: none;
  }

  .clips-filter-chip {
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .clips-filter-chip:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .clips-filter-chip.is-active {
    background: linear-gradient(120deg, rgba(139, 92, 246, 0.9), rgba(236, 72, 153, 0.75));
    border-color: transparent;
    color: white;
    box-shadow: 0 6px 20px -6px rgba(139, 92, 246, 0.6);
  }

  /* ═══════════════════════════════════════════════════════════ */
  /* Infinite Grid                                              */
  /* ═══════════════════════════════════════════════════════════ */

  .clips-grid-section {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 1.5rem 6rem;
  }

  .clips-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 480px) {
    .clips-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 768px) {
    .clips-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .clips-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.35rem;
    }
  }

  @media (min-width: 1300px) {
    .clips-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* Clip Card */
  :global(.clip-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    background: rgba(18, 15, 28, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  :global(.clip-card.animate-card-in) {
    animation: clipCardFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes clipCardFadeIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  :global(.clip-card:hover) {
    transform: translateY(-6px);
    border-color: rgba(139, 92, 246, 0.4);
    box-shadow: 0 20px 45px -18px rgba(0, 0, 0, 0.8), 0 0 25px rgba(139, 92, 246, 0.15);
  }

  :global(.clip-card-media) {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    cursor: pointer;
    background: #09070f;
  }

  :global(.clip-card-thumb) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.clip-card:hover .clip-card-thumb) {
    transform: scale(1.07);
  }

  :global(.clip-card-sheen) {
    position: absolute;
    inset: -50% -20%;
    z-index: 2;
    background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.14) 50%, transparent 60%);
    transform: translateX(-120%);
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  :global(.clip-card:hover .clip-card-sheen) {
    transform: translateX(20%);
  }

  :global(.clip-card-episode-tag) {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 4;
    max-width: calc(100% - 1.3rem);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.clip-card-play) {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0.85;
    transition: opacity 0.3s ease, background 0.3s ease;
  }

  :global(.clip-card:hover .clip-card-play) {
    opacity: 1;
    background: rgba(0, 0, 0, 0.4);
  }

  :global(.clip-card-play-btn) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.9), rgba(236, 72, 153, 0.9));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.clip-card:hover .clip-card-play-btn) {
    transform: scale(1.12);
  }

  :global(.clip-card-info) {
    padding: 0.85rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: linear-gradient(180deg, rgba(18, 15, 28, 0.95) 0%, rgba(12, 10, 20, 0.98) 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global(.clip-card-title) {
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    margin: 0;
    transition: color 0.2s ease;
  }

  :global(.clip-card-title:hover) {
    color: var(--color-primary, #a78bfa);
  }

  :global(.clip-card-actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  :global(.clip-action-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(.clip-action-btn:hover) {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    transform: scale(1.08);
  }

  :global(.clip-action-btn.like-btn.liked) {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.35);
    color: #ef4444;
  }

  :global(.clip-action-btn.watch-btn) {
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
    color: #a78bfa;
  }

  :global(.clip-action-btn.watch-btn:hover) {
