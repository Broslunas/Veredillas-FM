<script is:inline>
  (function () {
    const WIN = window;

    // Initialize global state container if not exists (survives astro:page-load re-runs)
    if (!WIN._clipsState) {
      WIN._clipsState = {
        players: {},
        playbackObserver: null,
        loadingObserver: null,
        urlObserver: null,
        queue: [],
        apiReady: false,
        soundUnlocked: false,
        currentIndex: 0,
      };
    }

    const state = WIN._clipsState;

    // --- YOUTUBE API SETUP (only needed for clips not yet self-hosted) ---
    if (!WIN.YT) {
      if (!document.getElementById('yt-api-script')) {
        const tag = document.createElement('script');
        tag.id = 'yt-api-script';
        tag.src = 'https://www.youtube.com/iframe_api';
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);
      }

      WIN.onYouTubeIframeAPIReady = function () {
        state.apiReady = true;
        processQueue();
      };
    } else {
      state.apiReady = true;
      setTimeout(processQueue, 0);
    }

    function processQueue() {
      while (state.queue.length > 0) {
        const id = state.queue.shift();
        if (id) createYouTubePlayer(id);
      }
    }

    function createYouTubePlayer(id) {
      if (!WIN.YT || !WIN.YT.Player) {
        if (!state.queue.includes(id)) state.queue.push(id);
        return;
      }
      if (state.players[id]) return;

      const element = document.getElementById(id);
      if (!element) return;
      const videoId = element.getAttribute('data-video-id');
      if (!videoId) return;

      state.players[id] = new WIN.YT.Player(id, {
        height: '100%',
        width: '100%',
        videoId: videoId,
        playerVars: {
          playsinline: 1,
          controls: 0,
          rel: 0,
          modestbranding: 1,
          showinfo: 0,
          iv_load_policy: 3,
          fs: 0,
          disablekb: 1,
          origin: WIN.location.origin,
        },
        events: {
          onStateChange: onPlayerStateChange,
        },
      });
    }

    function onPlayerStateChange(event) {
      if (event.data === WIN.YT.PlayerState.ENDED) {
        event.target.playVideo();
      }
    }

    // Lazily attach a source: create the YT player, or set the <video> src
    function initMedia(id) {
      const el = document.getElementById(id);
      if (!el) return;
      if (el.dataset.kind === 'youtube') {
        createYouTubePlayer(id);
      } else if (el.dataset.src && !el.getAttribute('src')) {
        el.src = el.dataset.src;
      }
    }

    function togglePlay(targetId) {
      const el = document.getElementById(targetId);
      if (!el) return;

      if (el.dataset.kind === 'youtube') {
        const player = state.players[targetId];
        if (player && typeof player.getPlayerState === 'function') {
          const playerState = player.getPlayerState();
          if (playerState === WIN.YT.PlayerState.PLAYING) {
            player.pauseVideo();
          } else {
            state.soundUnlocked = true;
            player.playVideo();
            player.unMute();
          }
        }
      } else {
        if (!el.paused) {
          el.pause();
        } else {
          state.soundUnlocked = true;
          el.muted = false;
          el.play().catch(() => {});
        }
      }
    }

    // Fully tears down a YouTube player (frees its iframe + video decoder) and drops
    // in a fresh placeholder div so the section can be reinitialized if scrolled back into view.
    function destroyYouTubePlayer(mediaEl, section) {
      const player = state.players[mediaEl.id];
      if (!player) return;
      try {
        player.destroy();
      } catch (e) {}
      delete state.players[mediaEl.id];

      const wrapper = section.querySelector('.video-wrapper');
      if (!wrapper || document.getElementById(mediaEl.id)) return;
      const placeholder = document.createElement('div');
      placeholder.id = mediaEl.id;
      placeholder.className = 'youtube-player';
      placeholder.dataset.kind = 'youtube';
      placeholder.dataset.videoId = section.getAttribute('data-video-id') || '';
      wrapper.insertBefore(placeholder, wrapper.firstChild);
    }

    // Releases whatever media a section is holding: destroys YouTube players outright
    // (each is a full iframe + video decoder) and clears native <video> sources.
    function unloadMedia(section) {
      const mediaEl = section.querySelector('.youtube-player, .native-player');
      if (!mediaEl) return;
      if (mediaEl.dataset.kind === 'youtube') {
        destroyYouTubePlayer(mediaEl, section);
      } else if (mediaEl.getAttribute('src')) {
        mediaEl.pause();
        mediaEl.removeAttribute('src');
        mediaEl.load();
      }
    }

    // Mobile browsers crash the tab (and it looks like a reload loop) once too many
    // YouTube iframes / buffered videos pile up while scrolling a long feed. Keep only
    // a small window of clips around the active one loaded at any time.
    const KEEP_RADIUS = 2;
    function cleanupDistantMedia(centerIndex) {
      document.querySelectorAll('.clip-section').forEach((section) => {
        const idx = parseInt(section.getAttribute('data-index') || '0', 10);
        if (Math.abs(idx - centerIndex) <= KEEP_RADIUS) return;
        unloadMedia(section);
      });
    }

    function unloadAllMedia() {
      document.querySelectorAll('.clip-section').forEach((section) => unloadMedia(section));
    }

    // --- OBSERVERS (scoped to the fullscreen viewer's own scroller) ---
    function attachObservers(scroller) {
      if (state.loadingObserver) state.loadingObserver.disconnect();
      if (state.playbackObserver) state.playbackObserver.disconnect();
      if (state.urlObserver) state.urlObserver.disconnect();

      state.loadingObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const mediaEl = entry.target.querySelector('.youtube-player, .native-player');
              if (mediaEl) initMedia(mediaEl.id);
            }
          });
        },
        { root: scroller, rootMargin: '50% 0px 50% 0px' }
      );

      state.playbackObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const mediaEl = entry.target.querySelector('.youtube-player, .native-player');
            if (!mediaEl) return;

            if (mediaEl.dataset.kind === 'youtube') {
              const player = state.players[mediaEl.id];
              if (entry.isIntersecting) {
                if (player && typeof player.playVideo === 'function') {
                  player.playVideo();
                  if (state.soundUnlocked && typeof player.unMute === 'function') player.unMute();
                }
              } else if (player && typeof player.pauseVideo === 'function') {
                player.pauseVideo();
              }
            } else {
              if (entry.isIntersecting) {
                if (mediaEl.dataset.src && !mediaEl.getAttribute('src')) mediaEl.src = mediaEl.dataset.src;
                if (state.soundUnlocked) mediaEl.muted = false;
                mediaEl.play().catch(() => {
                  // Autoplay-with-sound was blocked; fall back to muted so playback doesn't stall.
                  mediaEl.muted = true;
                  mediaEl.play().catch(() => {});
                });
              } else {
                mediaEl.pause();
              }
            }
          });
        },
        { root: scroller, rootMargin: '0px', threshold: 0.6 }
      );

      state.urlObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const videoId = entry.target.getAttribute('data-video-id');
              if (videoId) {
                const url = new URL(WIN.location.href);
                if (url.searchParams.get('watch') !== videoId) {
                  url.searchParams.set('watch', videoId);
                  WIN.history.replaceState({}, '', url);
                }
              }
              const idx = parseInt(entry.target.getAttribute('data-index') || '0', 10);
              state.currentIndex = idx;
              cleanupDistantMedia(idx);
            }
          });
        },
        { root: scroller, threshold: 0.7 }
      );

      document.querySelectorAll('.clip-section').forEach((section) => {
        state.loadingObserver.observe(section);
        state.playbackObserver.observe(section);
        state.urlObserver.observe(section);
      });
    }

    // --- VIEWER OPEN/CLOSE ---
    function openViewer(index) {
      const overlay = document.getElementById('clip-viewer-overlay');
      const scroller = document.getElementById('viewer-scroller');
      const target = document.getElementById('clip-section-' + index);
      if (!overlay || !scroller) return;

      if (target) scroller.scrollTop = target.offsetTop;

      document.body.classList.add('clip-viewer-open');
      overlay.classList.add('active');
      attachObservers(scroller);
    }

    function closeViewer() {
      const overlay = document.getElementById('clip-viewer-overlay');
      document.body.classList.remove('clip-viewer-open');
      overlay?.classList.remove('active');
      pauseAllMedia();
    }

    function closeViewerAndUpdateUrl() {
      closeViewer();
      const url = new URL(WIN.location.href);
      url.searchParams.delete('watch');
      WIN.history.replaceState({}, '', url);
    }

    function getClipIndexByVideoId(videoId) {
      const section = document.querySelector('.clip-section[data-video-id="' + CSS.escape(videoId) + '"]');
      return section ? parseInt(section.getAttribute('data-index') || '0', 10) : null;
    }

    // --- GALLERY -> VIEWER WIRING ---
    function initGallery() {
      const grid = document.getElementById('clips-grid');
      if (grid && !grid.dataset.wired) {
        grid.dataset.wired = '1';
        grid.addEventListener('click', (e) => {
          const card = e.target.closest('.clip-card');
          if (!card) return;
          e.preventDefault();
          state.soundUnlocked = true;
          const index = parseInt(card.getAttribute('data-index') || '0', 10);
          const videoId = card.getAttribute('data-video-id');
          const url = new URL(WIN.location.href);
          if (videoId) url.searchParams.set('watch', videoId);
          WIN.history.pushState({}, '', url);
          openViewer(index);
        });
      }

      document.querySelectorAll('.clips-tab').forEach((chip) => {
        chip.onclick = () => {
          document.querySelectorAll('.clips-tab').forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          const filter = chip.getAttribute('data-filter');
          document.querySelectorAll('.clip-card').forEach((card) => {
            const show = filter === 'all' || card.getAttribute('data-episode-slug') === filter;
            card.classList.toggle('is-hidden', !show);
          });
        };
      });
    }

    const closeBtn = document.getElementById('viewer-close-btn');
    if (closeBtn) {
      closeBtn.onclick = () => closeViewerAndUpdateUrl();
    }

    document.querySelectorAll('.interaction-layer').forEach((layer) => {
      layer.onclick = (e) => {
        const targetId = e.currentTarget.getAttribute('data-target');
        if (targetId) togglePlay(targetId);
      };
    });

    WIN.addEventListener('popstate', () => {
      const watch = new URLSearchParams(WIN.location.search).get('watch');
      const overlay = document.getElementById('clip-viewer-overlay');
      const scroller = document.getElementById('viewer-scroller');
      if (!watch) {
        if (overlay && overlay.classList.contains('active')) closeViewer();
        return;
      }
      const index = getClipIndexByVideoId(watch);
      if (index === null || !overlay || !scroller) return;
      if (!overlay.classList.contains('active')) {
        document.body.classList.add('clip-viewer-open');
        overlay.classList.add('active');
        attachObservers(scroller);
      }
      const target = document.getElementById('clip-section-' + index);
      if (target) scroller.scrollTop = target.offsetTop;
    });

    // --- GLOBAL ACTIONS (for onclick) ---
    WIN.handleLikeClip = async function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }

      const clipId = btn.getAttribute('data-clip-id');
      if (!clipId) return;

      const isLiked = btn.classList.contains('liked');

      if (isLiked) {
        btn.classList.remove('liked');
      } else {
        btn.classList.add('liked');
        btn
          .querySelector('.reel-action-icon')
          ?.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.25)' }, { transform: 'scale(1)' }], { duration: 200 });
      }

      try {
        const res = await fetch('/api/clips/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clipId }),
        });
        if (res.status === 401) {
          WIN.location.href = '/login';
          return;
        }
      } catch (e) {
        console.error(e);
        btn.classList.toggle('liked', isLiked);
      }
    };

    WIN.handleShareClip = function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }
      const clipId = btn.getAttribute('data-clip-id');
      const url = new URL(WIN.location.href);
      if (clipId) url.searchParams.set('watch', clipId);

      const iconWrap = btn.querySelector('.reel-action-icon');
      const label = btn.querySelector('.reel-action-label');
      if (!iconWrap || !label) return;

      navigator.clipboard.writeText(url.toString()).then(() => {
        const originalIcon = iconWrap.innerHTML;
        const originalLabel = label.textContent;
        iconWrap.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        label.textContent = 'Copiado';
        setTimeout(() => {
          iconWrap.innerHTML = originalIcon;
          label.textContent = originalLabel;
        }, 2000);
      });
    };

    // --- EPISODE CLIPS SIDE PANEL ---
    WIN.handleOpenEpisodeClips = function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }

      const slug = btn.getAttribute('data-episode-slug');
      if (!slug || !WIN._clipsByEpisode) return;

      const episodeData = WIN._clipsByEpisode[slug];
      if (!episodeData || !episodeData.clips || episodeData.clips.length === 0) return;

      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      const grid = document.getElementById('panel-clips-grid');
      const titleEl = document.getElementById('panel-episode-title');
      const imageEl = document.getElementById('panel-episode-image');
      const countEl = document.getElementById('panel-clips-count');
      if (!panel || !grid || !titleEl || !imageEl || !countEl || !backdrop) return;

      const currentWatch = new URLSearchParams(WIN.location.search).get('watch');

      titleEl.textContent = episodeData.episodeTitle;
      imageEl.src = episodeData.episodeImage;
      imageEl.alt = episodeData.episodeTitle;
      countEl.textContent = episodeData.clips.length + ' clips';

      grid.innerHTML = episodeData.clips
        .map((clip, i) => {
          const isActive = clip.videoId === currentWatch;
          const delay = (i * 0.06).toFixed(2);
          return (
            '<a class="grid-clip-card' +
            (isActive ? ' active-clip' : '') +
            '" href="/clips?watch=' +
            (clip.videoId || '') +
            '" style="animation-delay:' +
            delay +
            's">' +
            '<span class="grid-clip-badge">' +
            (i + 1) +
            '</span>' +
            '<img src="' +
            (clip.thumbnail || '') +
            '" alt="" loading="lazy" />' +
            '<div class="grid-play-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></div>' +
            '<div class="grid-clip-info">' +
            '<div class="grid-clip-title">' +
            clip.title +
            '</div>' +
            '</div>' +
            '</a>'
          );
        })
        .join('');

      panel.classList.add('active');
      backdrop.classList.add('active');
    };

    WIN.handleCloseEpisodeClips = function () {
      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      if (panel) panel.classList.remove('active');
      if (backdrop) backdrop.classList.remove('active');
    };

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      const panel = document.getElementById('episode-clips-panel');
      if (panel && panel.classList.contains('active')) {
        WIN.handleCloseEpisodeClips();
        return;
      }
      const overlay = document.getElementById('clip-viewer-overlay');
      if (overlay && overlay.classList.contains('active')) {
        closeViewerAndUpdateUrl();
      }
    });

    async function loadLikes() {
      try {
        const res = await fetch('/api/clips/liked');
        if (res.ok) {
          const data = await res.json();
          const liked = data.likedClips || [];
          document.querySelectorAll('.like-btn').forEach((btn) => {
            const cid = btn.getAttribute('data-clip-id');
            if (cid && liked.includes(cid)) {
              btn.classList.add('liked');
            }
          });
        }
      } catch (e) {
        console.error(e);
      }
    }

    // --- INIT ---
    function initPage() {
      if (!document.getElementById('clips-grid') && !document.getElementById('clip-viewer-overlay')) return;

      Object.values(state.players).forEach((p) => {
        if (p && typeof p.destroy === 'function') {
          try {
            p.destroy();
          } catch (e) {}
        }
      });
      state.players = {};

      initGallery();
      loadLikes();

      const watchId = new URLSearchParams(WIN.location.search).get('watch');
      if (watchId) {
        const index = getClipIndexByVideoId(watchId);
        if (index !== null) openViewer(index);
      }
    }

    if (!WIN._clipsPageLoadRegistered) {
      WIN._clipsPageLoadRegistered = true;
      document.addEventListener('astro:page-load', initPage);
    }

    initPage();
  })();
</script>
