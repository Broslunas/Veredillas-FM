---
import dbConnect from '@/lib/mongodb';
import ShareDesign from '@/models/ShareDesign';
import { migrateLegacyDesign } from '@/lib/story-card/legacy';
import type { CardModel } from '@/lib/story-card/types';

export const prerender = false;

const { id } = Astro.params;

if (!id) return Astro.redirect('/');

let model: CardModel | null = null;

try {
    await dbConnect();
    const design = await ShareDesign.findOne({ shortId: id.toUpperCase() });
    if (design) {
        if (design.version === 2 && design.model) {
            model = design.model as CardModel;
        } else if (design.data) {
            model = migrateLegacyDesign(design.data);
        }
    }
} catch (e) {
    console.error('Error fetching share state', e);
}

const title = model?.title || 'Veredillas FM';
const accentColor = model?.accent || '#8b5cf6';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #8b5cf6;
            --bg: #000;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body, html {
            margin: 0; padding: 0; background: var(--bg); color: white; width: 100%; height: 100%;
            overflow: hidden; font-family: 'Outfit', sans-serif;
        }

        /* Animated Mesh Background */
        .page-bg {
            position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
        }
        .mesh {
            position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background:
                radial-gradient(circle at 15% 20%, rgba(139, 92, 246, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(217, 70, 239, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(30, 58, 138, 0.1) 0%, transparent 60%);
            filter: blur(80px); animation: meshMove 25s infinite alternate ease-in-out;
        }
        @keyframes meshMove {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(5%, 5%) scale(1.1); }
        }

        .share-wrapper {
            height: 100vh; height: 100dvh; display: flex; flex-direction: column; align-items: center;
            justify-content: space-between; padding: env(safe-area-inset-top, 10px) 15px env(safe-area-inset-bottom, 15px) 15px;
            overflow: hidden;
        }

        .top-bar {
            width: 100%; padding: 15px 0; text-align: center; flex: none;
            opacity: 0; animation: fadeInDown 0.6s ease-out forwards;
        }
        .logo-text { font-size: 0.9rem; font-weight: 900; letter-spacing: 0.3em; margin: 0; text-transform: uppercase; color: rgba(255,255,255,0.6); }

        .card-arena {
            flex: 1; width: 100%; position: relative; display: flex; align-items: center; justify-content: center;
            perspective: 2000px; overflow: hidden;
        }

        .card-scaler {
            position: absolute; top: 50%; left: 50%; width: 1080px; height: 1920px;
            transform-origin: center center;
            box-shadow: 0 30px 100px -20px rgba(0,0,0,0.8), 0 0 40px rgba(139, 92, 246, 0.2);
            border-radius: 40px;
            visibility: hidden;
            animation: cardPop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .frosted-glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
        }

        .bottom-bar {
            width: 100%; max-width: 400px; padding: 10px 0 20px 0; display: flex; flex-direction: column;
            gap: 12px; z-index: 10;
        }

        .save-button {
            background: white; color: black; border: none; font-size: 1.05rem; font-weight: 700;
            padding: 16px; border-radius: 100px; display: flex; align-items: center; justify-content: center;
            gap: 10px; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 25px -5px rgba(255, 255, 255, 0.4);
            width: 100%;
        }
        .save-button:active { transform: scale(0.97); }

        .outline-button {
            background: rgba(255, 255, 255, 0.08); color: white; border: 1.5px solid rgba(255, 255, 255, 0.15);
            font-size: 0.95rem; font-weight: 600; padding: 14px; border-radius: 100px; display: flex;
            align-items: center; justify-content: center; gap: 8px; cursor: pointer;
            backdrop-filter: blur(10px);
            width: 100%;
        }

        .listen-link {
            color: rgba(255, 255, 255, 0.5); font-size: 0.85rem; font-weight: 600; text-decoration: none;
            text-align: center; margin-top: 4px;
        }

        .not-found { text-align: center; margin: auto; }
        .not-found h2 { font-size: 1.5rem; margin-bottom: 12px; }
        .not-found a { color: var(--accent); text-decoration: none; font-weight: 700; }

        @keyframes cardPop {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .spin {
            width: 20px; height: 20px; border: 2px solid rgba(0,0,0,0.2); border-top-color: black;
            border-radius: 50%; animation: spin 0.8s linear infinite; display: inline-block;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="page-bg"><div class="mesh"></div></div>

    <div class="share-wrapper" style={`--accent: ${accentColor}`}>
        {model ? (
            <>
                <header class="top-bar">
                    <p class="logo-text">Veredillas FM</p>
                </header>

                <div class="card-arena">
                    <div class="card-scaler" id="card-scaler">
                        <!-- Card mounted via shared story-card engine -->
                        <div id="card-mount-container" style="width:1080px;height:1920px;"></div>
                    </div>
                </div>

                <div class="bottom-bar">
                    <button class="save-button" id="save-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Guardar Historia</span>
                    </button>
                    <button class="outline-button" id="share-native-btn" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                        <span>Enviar por Correo / App</span>
                    </button>
                    <a href={model.websiteLabel ? `https://${model.websiteLabel}` : '/'} class="listen-link">Volver al Episodio</a>
                </div>

                <!-- Embed model data for client-side rendering -->
                <script id="card-model-data" type="application/json" set:html={JSON.stringify(model)} />
            </>
        ) : (
            <div class="not-found">
                <h2>Diseño no disponible</h2>
                <a href="/">Volver al Inicio</a>
            </div>
        )}
    </div>

    <script>
        import * as htmlToImage from 'html-to-image';
        import { composeCardTree } from '@/lib/story-card/composeCard';
        import { renderCardIntoDom } from '@/lib/story-card/renderDom';
        import { classic } from '@/lib/story-card/looks/classic';
        import type { CardModel } from '@/lib/story-card/types';

        const dataScript = document.getElementById('card-model-data');
        const mountContainer = document.getElementById('card-mount-container');

        if (dataScript && mountContainer && dataScript.textContent) {
            try {
                const model: CardModel = JSON.parse(dataScript.textContent);
                const tree = composeCardTree(model, classic);
                renderCardIntoDom(tree, mountContainer);
            } catch (err) {
                console.error('[share-qr] Failed to render card tree:', err);
            }
        }

        const btn = document.getElementById('save-btn');
        const shareNativeBtn = document.getElementById('share-native-btn');
        const scaler = document.getElementById('card-scaler');
        const card = mountContainer?.querySelector('#share-card') || mountContainer;

        const nav = navigator as any;

        if (nav.canShare) {
            if (shareNativeBtn) shareNativeBtn.style.display = 'flex';
        }

        // --- Fitting Logic ---
        const fitCard = () => {
            if (!scaler) return;
            const arena = document.querySelector('.card-arena');
            if (!arena) return;

            const padding = 40;
            const availableW = arena.clientWidth - padding;
            const availableH = arena.clientHeight - padding;

            const scaleW = availableW / 1080;
            const scaleH = availableH / 1920;
            const scale = Math.min(scaleW, scaleH);

            scaler.style.transform = `translate(-50%, -50%) scale(${scale})`;
            scaler.style.visibility = 'visible';
        };

        window.addEventListener('resize', fitCard);
        fitCard();
        document.fonts.ready.then(fitCard);

        const generateBlob = async () => {
            const targetEl = mountContainer?.querySelector('#share-card') as HTMLElement || mountContainer;
            if (!targetEl) return null;
            const imgs = Array.from(targetEl.querySelectorAll('img'));
            await Promise.all(imgs.map(img => {
                if (img.complete) return Promise.resolve();
                return new Promise(r => { img.onload = r; img.onerror = r; });
            }));

            await new Promise(r => setTimeout(r, 200));

            return await htmlToImage.toBlob(targetEl, {
                pixelRatio: 2.2,
                width: 1080,
                height: 1920,
                cacheBust: true,
                style: {
                    transform: 'none',
                    left: '0',
                    top: '0',
                    margin: '0',
                    position: 'relative',
                    visibility: 'visible',
                    opacity: '1'
                }
            });
        };

        shareNativeBtn?.addEventListener('click', async () => {
            const originalHTML = shareNativeBtn.innerHTML;
            shareNativeBtn.innerHTML = '<span class="spin"></span>';
            (shareNativeBtn as HTMLButtonElement).disabled = true;

            try {
                const blob = await generateBlob();
                if (!blob) throw new Error('Render failed');

                const file = new File([blob], `Veredillas_Story_${Date.now()}.png`, { type: 'image/png' });

                if (nav.canShare && nav.canShare({ files: [file] })) {
                    await nav.share({
                        title: 'Episodio de Veredillas FM',
                        text: '¡Mira este fragmento del podcast!',
                        files: [file]
                    });
                } else {
                    alert('Tu dispositivo no permite compartir archivos directamente.');
                }
            } catch (err: unknown) {
                console.error(err);
            } finally {
                shareNativeBtn.innerHTML = originalHTML;
                (shareNativeBtn as HTMLButtonElement).disabled = false;
            }
        });

        btn?.addEventListener('click', async () => {
            if (!btn) return;

            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<span class="spin"></span>';
            (btn as HTMLButtonElement).disabled = true;

            try {
                const blob = await generateBlob();
                if (!blob) throw new Error('Render failed');

                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Veredillas_Story_${Date.now()}.png`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (err) {
                console.error('Error saving image:', err);
                alert('Error al generar la imagen. Prueba a hacer una captura de pantalla.');
            } finally {
                btn.innerHTML = originalHTML;
                (btn as HTMLButtonElement).disabled = false;
            }
        });
    </script>
</body>
</html>
