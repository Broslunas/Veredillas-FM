---
import { getCollection } from '@/lib/content';
import { resolveClipVideoId, resolveClipThumbnail, resolveClipPlayback } from '@/lib/clips';

interface Props {
  initialWatchId?: string;
}

const { initialWatchId } = Astro.props;

// A direct /clip/{id} link is a single-video permalink: don't pay for building and
// loading the entire gallery grid (517 thumbnails) in the background just to show one
// video behind it. The gallery only renders for the bare /clips route.
const showGallery = !initialWatchId;

const allEpisodes = await getCollection('episodios');

// Flatten every episode's clips into a single gallery feed
let clips = allEpisodes
  .flatMap((episode) => {
    return (episode.data.clips || []).map((clip: any) => {
      const videoId = resolveClipVideoId(clip);
      const playback = resolveClipPlayback(clip);
      return {
        title: clip.title,
        videoId,
        thumbnail: resolveClipThumbnail(clip),
        playbackKind: playback.kind,
        mediaSrc: playback.kind === 'youtube' ? playback.videoId || '' : playback.url,
        episodeTitle: episode.data.title,
        episodeSlug: episode.slug,
        episodeImage:
          typeof episode.data.image === 'string' ? episode.data.image : episode.data.image?.src || '/placeholder.jpg',
      };
    });
  })
  .filter((clip) => clip.videoId)
  .sort(() => Math.random() - 0.5); // Simple shuffle

// Build a map of clips grouped by episode slug for the side panel
const clipsByEpisode: Record<
  string,
  { episodeTitle: string; episodeImage: string; clips: Array<{ title: string; videoId: string; thumbnail: string }> }
> = {};
allEpisodes.forEach((episode) => {
  const epClips = (episode.data.clips || [])
    .map((clip: any) => ({ title: clip.title, videoId: resolveClipVideoId(clip), thumbnail: resolveClipThumbnail(clip) }))
    .filter((c: any) => c.videoId);
  if (epClips.length > 0) {
    clipsByEpisode[episode.slug] = {
      episodeTitle: episode.data.title,
      episodeImage:
        typeof episode.data.image === 'string' ? episode.data.image : episode.data.image?.src || '/placeholder.jpg',
      clips: epClips,
    };
  }
});

// If a specific clip was requested, move it to the front so the viewer opens there
if (initialWatchId) {
  const index = clips.findIndex((c) => c.videoId === initialWatchId);
  if (index > -1) {
    const [selectedClip] = clips.splice(index, 1);
    clips.unshift(selectedClip);
  }
}

// Distinct episodes represented in the feed, in feed order, for the filter row
const seenSlugs = new Set<string>();
const episodeOptions = clips
  .filter((c) => {
    if (seenSlugs.has(c.episodeSlug)) return false;
    seenSlugs.add(c.episodeSlug);
    return true;
  })
  .map((c) => ({ slug: c.episodeSlug, title: c.episodeTitle }));

// The gallery grid below renders every clip (just lightweight thumbnails, that's fine).
// The fullscreen viewer is a different story: each section can become a full YouTube
// iframe or buffered <video>, and mobile browsers crash once too many of those exist
// at once. So the viewer only gets an initial handful server-rendered; the rest of the
// (already-ordered) list is handed to the client as plain data, and JS builds more
// viewer sections on demand as the user scrolls (see the script below).
const VIEWER_INITIAL_BATCH = 6;
const viewerClips = clips.slice(0, VIEWER_INITIAL_BATCH);
const feedClips = clips.map((c) => ({
  videoId: c.videoId,
  title: c.title,
  playbackKind: c.playbackKind,
  mediaSrc: c.mediaSrc,
  episodeSlug: c.episodeSlug,
  episodeTitle: c.episodeTitle,
}));
---

{showGallery && (
<>
<section class="clips-hero">
  <div class="clips-bg-glow" aria-hidden="true"></div>

  {episodeOptions.length > 0 && (
    <div class="clips-marquee" aria-hidden="true">
      <div class="clips-marquee-track">
        {[...episodeOptions, ...episodeOptions].map((ep) => (
          <span class="clips-marquee-item">
            {ep.title}
            <span class="clips-marquee-dot">●</span>
          </span>
        ))}
      </div>
    </div>
  )}

  <div class="clips-hero-inner">
    <div class="clips-eyebrow">
      <span class="clips-eyebrow-dot"></span>
      Momentos destacados
    </div>
    <div class="clips-title-row">
      <h1 class="clips-title">Clips</h1>
      {clips.length > 0 && <span class="clips-count-chip">{clips.length} clips</span>}
    </div>
    <p class="clips-subtitle">Los mejores momentos de Veredillas FM, en formato corto.</p>
  </div>

  {episodeOptions.length > 1 && (
    <div class="clips-filter-row" id="clips-filter-row">
      <button class="clips-tab is-active" data-filter="all">Todos</button>
      {episodeOptions.map((ep) => (
        <button class="clips-tab" data-filter={ep.slug}>{ep.title}</button>
      ))}
    </div>
  )}
</section>

<section class="clips-grid-section">
  {clips.length > 0 ? (
    <div class="clips-grid" id="clips-grid">
      {clips.map((clip, index) => (
        <a
          href={`/clip/${clip.videoId}`}
          class:list={['clip-card', { 'is-featured': index === 0 }]}
          data-index={index}
          data-video-id={clip.videoId}
          data-episode-slug={clip.episodeSlug}
        >
          <img class="clip-card-thumb" src={clip.thumbnail} alt="" loading="lazy" />
          <div class="clip-card-sheen" aria-hidden="true"></div>
          <span class="clip-card-episode-tag">{clip.episodeTitle}</span>
          <div class="clip-card-play">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>
          <div class="clip-card-overlay">
            {index === 0 && <span class="clip-card-featured-badge">Destacado</span>}
            <h3 class="clip-card-title">{clip.title}</h3>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="no-clips">
      <p>No hay clips disponibles por el momento.</p>
      <a href="/ep" class="btn btn-primary">Ver episodios</a>
    </div>
  )}
</section>
</>
)}

<!-- Fullscreen TikTok-style viewer, opened from the gallery -->
<div id="clip-viewer-overlay" class="clip-viewer-overlay">
  <button class="viewer-close-btn" id="viewer-close-btn" aria-label="Cerrar">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>

  <div class="viewer-scroller" id="viewer-scroller">
    {viewerClips.map((clip, index) => (
      <div class="clip-section is-loading" id={`clip-section-${index}`} data-index={index} data-video-id={clip.videoId}>
        <div class="video-wrapper">
          {clip.playbackKind === 'youtube' ? (
            <div id={`player-${index}`} class="youtube-player" data-kind="youtube" data-video-id={clip.mediaSrc}></div>
          ) : (
            <video id={`player-${index}`} class="native-player" data-kind="self-hosted" data-src={clip.mediaSrc} loop playsinline muted></video>
          )}
          <!-- Shown until the media reports it's actually ready to play -->
          <div class="clip-skeleton" aria-hidden="true">
            <div class="clip-skeleton-shimmer"></div>
            <div class="clip-skeleton-ring"></div>
          </div>
          <!-- Interaction layer for custom play/pause -->
          <div class="interaction-layer" data-target={`player-${index}`}></div>
        </div>

        <div class="clip-overlay">
          <div class="clip-info">
            <h2 class="clip-title">{clip.title}</h2>
            <a href={`/ep/${clip.episodeSlug}`} class="episode-link">
              <span class="episode-icon" aria-hidden="true"></span>
              <span class="episode-name">{clip.episodeTitle}</span>
            </a>
          </div>

          <div class="clip-actions">
            <button class="reel-action episode-clips-btn" aria-label="Ver clips del episodio" data-episode-slug={clip.episodeSlug} onclick="handleOpenEpisodeClips(this)">
              <span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg></span>
              <span class="reel-action-label">Clips</span>
            </button>
            <button class="reel-action like-btn" aria-label="Me gusta" data-clip-id={clip.videoId} onclick="handleLikeClip(this)">
              <span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></span>
              <span class="reel-action-label">Me gusta</span>
            </button>
            <button class="reel-action share-btn" aria-label="Compartir" data-clip-id={clip.videoId} onclick="handleShareClip(this)">
              <span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg></span>
              <span class="reel-action-label">Compartir</span>
            </button>
            <a href={`/ep/${clip.episodeSlug}`} class="reel-action" aria-label="Ver episodio completo">
              <span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span>
              <span class="reel-action-label">Episodio</span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<!-- Episode Clips Side Panel -->
<div id="episode-panel-backdrop" class="panel-backdrop" onclick="handleCloseEpisodeClips()"></div>
<aside id="episode-clips-panel" class="episode-clips-panel">
  <div class="panel-header">
    <button class="panel-close-btn" onclick="handleCloseEpisodeClips()" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="panel-episode-hero">
    <img id="panel-episode-image" class="panel-episode-cover" src="" alt="" />
    <div class="panel-episode-meta">
      <h3 id="panel-episode-title" class="panel-episode-title">Episodio</h3>
      <span id="panel-clips-count" class="panel-clips-count"></span>
    </div>
  </div>
  <div id="panel-clips-grid" class="panel-clips-grid">
    <!-- Populated dynamically -->
  </div>
</aside>

<!-- Inject clips-by-episode data for JS -->
<script is:inline define:vars={{ clipsByEpisode, feedClips, viewerInitialBatch: VIEWER_INITIAL_BATCH }}>
  window._clipsByEpisode = clipsByEpisode;
  // Full ordered clip list as plain data (title/ids/src, no thumbnails) so the viewer
  // can build more sections on demand instead of the server rendering all of them.
  window._allClips = feedClips;
  window._viewerInitialBatch = viewerInitialBatch;
</script>

<style>
  :global(body.clip-viewer-open) {
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════════════════════ */
  /* Gallery                                                     */
  /* ═══════════════════════════════════════════════════════════ */

  .clips-hero {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1.5rem 1.5rem;
    overflow: hidden;
  }

  .clips-bg-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .clips-bg-glow::before,
  .clips-bg-glow::after {
    content: '';
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.22;
  }

  .clips-bg-glow::before {
    top: -220px;
    left: -120px;
    background: var(--color-primary);
  }

  .clips-bg-glow::after {
    top: -160px;
    right: -160px;
    background: var(--color-accent);
  }

  .clips-marquee {
    overflow: hidden;
    margin-bottom: 2.5rem;
    opacity: 0.5;
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }

  .clips-marquee-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    animation: clips-marquee-scroll 45s linear infinite;
  }

  .clips-marquee:hover .clips-marquee-track {
    animation-play-state: paused;
  }

  .clips-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .clips-marquee-dot {
    color: var(--color-primary);
    font-size: 0.4rem;
  }

  @keyframes clips-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clips-marquee-track {
      animation: none;
    }
  }

  .clips-hero-inner {
    margin-bottom: 1.5rem;
  }

  .clips-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-primary);
    font-weight: 900;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 1rem;
  }

  .clips-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 10px var(--color-primary-glow);
  }

  .clips-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .clips-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 0.75rem;
    text-shadow: 0 0 60px rgba(var(--color-primary-rgb), 0.25);
  }

  .clips-count-chip {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.9rem;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-full, 999px);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
  }

  .clips-subtitle {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 40ch;
  }

  .clips-filter-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    mask-image: linear-gradient(90deg, black 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, black 88%, transparent);
  }

  .clips-filter-row::-webkit-scrollbar {
    display: none;
  }

  .clips-tab {
    position: relative;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0.2rem 0.05rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-dim);
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .clips-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.95rem;
    height: 2px;
    background: linear-gradient(120deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .clips-tab:hover {
    color: var(--color-text-main);
  }

  .clips-tab.is-active {
    color: var(--color-text-main);
  }

  .clips-tab.is-active::after {
    transform: scaleX(1);
  }

  .clips-grid-section {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .clips-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .clips-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .clips-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1400px) {
    .clips-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .clip-card {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-xl, 1.25rem);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .clip-card.is-hidden {
    display: none;
  }

  .clip-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--color-primary-rgb), 0.5);
    box-shadow: 0 20px 45px -18px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(var(--color-primary-rgb), 0.2);
  }

  @media (min-width: 640px) {
    .clip-card.is-featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .clip-card.is-featured .clip-card-title {
      font-size: 1.2rem;
      -webkit-line-clamp: 3;
    }

    .clip-card.is-featured .clip-card-episode-tag {
      font-size: 0.68rem;
      padding: 0.4rem 0.8rem;
    }
  }

  .clip-card-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .clip-card:hover .clip-card-thumb {
    transform: scale(1.06);
  }

  .clip-card-sheen {
    position: absolute;
    inset: -50% -20%;
    z-index: 2;
    background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.16) 50%, transparent 60%);
    transform: translateX(-120%);
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .clip-card:hover .clip-card-sheen {
    transform: translateX(20%);
  }

  .clip-card-episode-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 4;
    max-width: calc(100% - 1.2rem);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(10, 8, 16, 0.6);
    border-left: 2px solid var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.56rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .clip-card-play {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .clip-card-play svg {
    width: 42px;
    height: 42px;
    padding: 13px;
    border-radius: var(--radius-lg);
    background: rgba(10, 8, 16, 0.55);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .clip-card:hover .clip-card-play {
    opacity: 1;
  }

  .clip-card:hover .clip-card-play svg {
    border-color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.3);
  }

  .clip-card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    padding: 1.75rem 0.75rem 0.65rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.35) 60%, transparent 100%);
  }

  .clip-card-featured-badge {
    display: inline-block;
    margin-bottom: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(120deg, var(--color-primary), var(--color-accent));
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: white;
  }

  .clip-card-title {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.95);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .no-clips {
    min-height: 40vh;
    display: flex;
    flex-direction: column;
    align-items: center;
