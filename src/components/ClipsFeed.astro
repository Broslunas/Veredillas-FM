<script is:inline>
  (function () {
    const WIN = window;

    // Initialize global state container if not exists (survives astro:page-load re-runs)
    if (!WIN._clipsState) {
      WIN._clipsState = {
        players: {},
        playbackObserver: null,
        loadingObserver: null,
        urlObserver: null,
        queue: [],
        apiReady: false,
        soundUnlocked: false,
        currentIndex: 0,
        loadedCount: 0,
        feedCursor: 0,
      };
    }

    const state = WIN._clipsState;

    // --- URL HELPERS (path-based: /clip/{id} instead of /clips?watch={id}) ---
    function watchUrl(id) {
      const url = new URL(WIN.location.href);
      url.pathname = '/clip/' + encodeURIComponent(id);
      return url;
    }

    function getWatchIdFromLocation() {
      const match = WIN.location.pathname.match(/^\/clip\/([^/]+)\/?$/);
      return match ? decodeURIComponent(match[1]) : null;
    }

    // --- YOUTUBE API SETUP (only needed for clips not yet self-hosted) ---
    if (!WIN.YT) {
      if (!document.getElementById('yt-api-script')) {
        const tag = document.createElement('script');
        tag.id = 'yt-api-script';
        tag.src = 'https://www.youtube.com/iframe_api';
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);
      }

      WIN.onYouTubeIframeAPIReady = function () {
        state.apiReady = true;
        processQueue();
      };
    } else {
      state.apiReady = true;
      setTimeout(processQueue, 0);
    }

    function processQueue() {
      while (state.queue.length > 0) {
        const id = state.queue.shift();
        if (id) createYouTubePlayer(id);
      }
    }

    // Hides the loading skeleton for whichever section owns this media element id.
    function markLoaded(mediaElId) {
      const el = document.getElementById(mediaElId);
      const section = el ? el.closest('.clip-section') : null;
      section?.classList.remove('is-loading');
    }

    function createYouTubePlayer(id) {
      if (!WIN.YT || !WIN.YT.Player) {
        if (!state.queue.includes(id)) state.queue.push(id);
        return;
      }
      if (state.players[id]) return;

      const element = document.getElementById(id);
      if (!element) return;
      const videoId = element.getAttribute('data-video-id');
      if (!videoId) return;

      state.players[id] = new WIN.YT.Player(id, {
        height: '100%',
        width: '100%',
        videoId: videoId,
        playerVars: {
          playsinline: 1,
          controls: 0,
          rel: 0,
          modestbranding: 1,
          showinfo: 0,
          iv_load_policy: 3,
          fs: 0,
          disablekb: 1,
          origin: WIN.location.origin,
        },
        events: {
          onStateChange: (event) => onPlayerStateChange(event, id),
        },
      });
    }

    function onPlayerStateChange(event, id) {
      if (event.data === WIN.YT.PlayerState.ENDED) {
        event.target.playVideo();
      }
      if (event.data === WIN.YT.PlayerState.PLAYING || event.data === WIN.YT.PlayerState.BUFFERING) {
        markLoaded(id);
      }
    }

    // Lazily attach a source: create the YT player, or set the <video> src
    function initMedia(id) {
      const el = document.getElementById(id);
      if (!el) return;
      if (el.dataset.kind === 'youtube') {
        createYouTubePlayer(id);
      } else if (el.dataset.src && !el.getAttribute('src')) {
        el.src = el.dataset.src;
        const markReady = () => markLoaded(id);
        // Mobile Safari in particular can defer actually fetching video data until
        // playback starts, so `loadeddata` alone isn't reliable here — listen for a few
        // signals and also hard-timeout, so the skeleton can never get stuck forever
        // and mask a video that's actually fine underneath.
        el.addEventListener('loadeddata', markReady, { once: true });
        el.addEventListener('canplay', markReady, { once: true });
        el.addEventListener('playing', markReady, { once: true });
        setTimeout(markReady, 3500);
      }
    }

    function togglePlay(targetId) {
      const el = document.getElementById(targetId);
      if (!el) return;

      if (el.dataset.kind === 'youtube') {
        const player = state.players[targetId];
        if (player && typeof player.getPlayerState === 'function') {
          const playerState = player.getPlayerState();
          if (playerState === WIN.YT.PlayerState.PLAYING) {
            player.pauseVideo();
          } else {
            state.soundUnlocked = true;
            player.playVideo();
            player.unMute();
          }
        }
      } else {
        if (!el.paused) {
          el.pause();
        } else {
          state.soundUnlocked = true;
          el.muted = false;
          el.play().catch(() => {});
        }
      }
    }

    // Fully tears down a YouTube player (frees its iframe + video decoder) and drops
    // in a fresh placeholder div so the section can be reinitialized if scrolled back into view.
    function destroyYouTubePlayer(mediaEl, section) {
      const player = state.players[mediaEl.id];
      if (!player) return;
      try {
        player.destroy();
      } catch (e) {}
      delete state.players[mediaEl.id];
      section.classList.add('is-loading');

      const wrapper = section.querySelector('.video-wrapper');
      if (!wrapper || document.getElementById(mediaEl.id)) return;
      const placeholder = document.createElement('div');
      placeholder.id = mediaEl.id;
      placeholder.className = 'youtube-player';
      placeholder.dataset.kind = 'youtube';
      placeholder.dataset.videoId = section.getAttribute('data-video-id') || '';
      wrapper.insertBefore(placeholder, wrapper.firstChild);
    }

    // Releases whatever media a section is holding: destroys YouTube players outright
    // (each is a full iframe + video decoder) and clears native <video> sources.
    function unloadMedia(section) {
      const mediaEl = section.querySelector('.youtube-player, .native-player');
      if (!mediaEl) return;
      if (mediaEl.dataset.kind === 'youtube') {
        destroyYouTubePlayer(mediaEl, section);
      } else if (mediaEl.getAttribute('src')) {
        mediaEl.pause();
        mediaEl.removeAttribute('src');
        mediaEl.load();
        section.classList.add('is-loading');
      }
    }

    // Mobile browsers crash the tab (and it looks like a reload loop) once too many
    // YouTube iframes / buffered videos pile up while scrolling a long feed. Keep only
    // a small window of clips around the active one loaded at any time.
    const KEEP_RADIUS = 2;
    function cleanupDistantMedia(centerIndex) {
      document.querySelectorAll('.clip-section').forEach((section) => {
        const idx = parseInt(section.getAttribute('data-index') || '0', 10);
        if (Math.abs(idx - centerIndex) <= KEEP_RADIUS) return;
        unloadMedia(section);
      });
    }

    function unloadAllMedia() {
      document.querySelectorAll('.clip-section').forEach((section) => unloadMedia(section));
    }

    // --- INCREMENTAL VIEWER BUILDING ---
    // Only a handful of clip-sections are server-rendered; window._allClips carries the
    // full ordered list as plain data (no thumbnails, cheap to ship) and the functions
    // below build more sections from it as the user scrolls, instead of the server
    // rendering all 500+ upfront.
    function escapeHtml(str) {
      return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    }

    function buildClipSectionHTML(clip, index) {
      const videoId = escapeHtml(clip.videoId);
      const title = escapeHtml(clip.title);
      const episodeSlug = escapeHtml(clip.episodeSlug);
      const episodeTitle = escapeHtml(clip.episodeTitle);
      const mediaSrc = escapeHtml(clip.mediaSrc);
      const playerId = 'player-' + index;
      const mediaHtml =
        clip.playbackKind === 'youtube'
          ? '<div id="' + playerId + '" class="youtube-player" data-kind="youtube" data-video-id="' + mediaSrc + '"></div>'
          : '<video id="' + playerId + '" class="native-player" data-kind="self-hosted" data-src="' + mediaSrc + '" loop playsinline muted></video>';

      return (
        '<div class="clip-section is-loading" id="clip-section-' + index + '" data-index="' + index + '" data-video-id="' + videoId + '">' +
          '<div class="video-wrapper">' +
            mediaHtml +
            '<div class="clip-skeleton" aria-hidden="true"><div class="clip-skeleton-shimmer"></div><div class="clip-skeleton-ring"></div></div>' +
            '<div class="interaction-layer" data-target="' + playerId + '"></div>' +
          '</div>' +
          '<div class="clip-overlay">' +
            '<div class="clip-info">' +
              '<h2 class="clip-title">' + title + '</h2>' +
              '<a href="/ep/' + episodeSlug + '" class="episode-link">' +
                '<span class="episode-icon" aria-hidden="true"></span>' +
                '<span class="episode-name">' + episodeTitle + '</span>' +
              '</a>' +
            '</div>' +
            '<div class="clip-actions">' +
              '<button class="reel-action episode-clips-btn" aria-label="Ver clips del episodio" data-episode-slug="' + episodeSlug + '" onclick="handleOpenEpisodeClips(this)">' +
                '<span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg></span>' +
                '<span class="reel-action-label">Clips</span>' +
              '</button>' +
              '<button class="reel-action like-btn" aria-label="Me gusta" data-clip-id="' + videoId + '" onclick="handleLikeClip(this)">' +
                '<span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></span>' +
                '<span class="reel-action-label">Me gusta</span>' +
              '</button>' +
              '<button class="reel-action share-btn" aria-label="Compartir" data-clip-id="' + videoId + '" onclick="handleShareClip(this)">' +
                '<span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg></span>' +
                '<span class="reel-action-label">Compartir</span>' +
              '</button>' +
              '<a href="/ep/' + episodeSlug + '" class="reel-action" aria-label="Ver episodio completo">' +
                '<span class="reel-action-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span>' +
                '<span class="reel-action-label">Episodio</span>' +
              '</a>' +
            '</div>' +
          '</div>' +
        '</div>'
      );
    }

    // Appends clip-sections built from `list` and, if a viewer session is already
    // observing, wires them into the same observers so they play on scroll like any
    // server-rendered section.
    function appendClips(list) {
      const scroller = document.getElementById('viewer-scroller');
      if (!scroller || !list || list.length === 0) return;
      let html = '';
      let idx = state.loadedCount;
      list.forEach((clip) => {
        html += buildClipSectionHTML(clip, idx);
        idx++;
      });
      scroller.insertAdjacentHTML('beforeend', html);
      for (let i = state.loadedCount; i < idx; i++) {
        const section = document.getElementById('clip-section-' + i);
        if (!section) continue;
        state.loadingObserver?.observe(section);
        state.playbackObserver?.observe(section);
        state.urlObserver?.observe(section);
      }
      state.loadedCount = idx;
      applyLikedState();
    }

    // Pulls the next slice from window._allClips (already-ordered, no network round-trip
    // needed) and appends it. Wraps back to the start once the catalog is exhausted, so
    // the reel scrolls forever instead of dead-ending after the last of the ~500 clips.
    function loadNextBatch() {
      const all = WIN._allClips || [];
      if (all.length === 0) return;
      const batchSize = WIN._viewerInitialBatch || 6;
      const batch = [];
      for (let i = 0; i < batchSize; i++) {
        batch.push(all[(state.feedCursor + i) % all.length]);
      }
      state.feedCursor += batch.length;
      appendClips(batch);
    }

    // Secondary trigger from the urlObserver: load more once the active clip is close to
    // the end of what's loaded.
    function maybeLoadMore(centerIndex) {
      if (centerIndex < state.loadedCount - 3) return;
      loadNextBatch();
    }

    // Primary trigger: a plain scroll-position check on the scroller itself. More robust
    // than relying only on IntersectionObserver threshold crossings, which can be
    // unreliable during fast native scroll-snap gestures on some mobile browsers.
    function checkScrollLoadMore(scroller) {
      const remaining = scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight;
      if (remaining < scroller.clientHeight * 2) {
        loadNextBatch();
      }
    }

    // Infinite scroll means the DOM would otherwise grow without bound over a long
    // session (the same crash risk we fixed for the initial load). Once a section is
    // well behind the active one, drop it entirely instead of just unloading its media.
    const PRUNE_RADIUS = 20;
    function pruneDistantSections(centerIndex) {
      document.querySelectorAll('.clip-section').forEach((section) => {
        const idx = parseInt(section.getAttribute('data-index') || '0', 10);
        if (idx >= centerIndex - PRUNE_RADIUS) return;
        unloadMedia(section);
        state.loadingObserver?.unobserve(section);
        state.playbackObserver?.unobserve(section);
        state.urlObserver?.unobserve(section);
        section.remove();
      });
    }

    // Used when the requested clip isn't among the currently-loaded sections (e.g. a
    // gallery card far down the list, or a back/forward jump): wipes the viewer and
    // rebuilds it starting at that clip instead of relying on it already being in the DOM.
    function resetViewerTo(videoId) {
      const all = WIN._allClips || [];
      const startIdx = all.findIndex((c) => c.videoId === videoId);
      if (startIdx === -1) return false;

      const scroller = document.getElementById('viewer-scroller');
      if (!scroller) return false;

      Object.values(state.players).forEach((p) => {
        if (p && typeof p.destroy === 'function') {
          try {
            p.destroy();
          } catch (e) {}
        }
      });
      state.players = {};
      scroller.innerHTML = '';
      state.loadedCount = 0;

      const batchSize = WIN._viewerInitialBatch || 6;
      const batch = all.slice(startIdx, startIdx + batchSize);
      state.feedCursor = startIdx + batch.length;
      appendClips(batch);
      openViewer(0);
      return true;
    }

    // --- OBSERVERS (scoped to the fullscreen viewer's own scroller) ---
    function attachObservers(scroller) {
      if (state.loadingObserver) state.loadingObserver.disconnect();
      if (state.playbackObserver) state.playbackObserver.disconnect();
      if (state.urlObserver) state.urlObserver.disconnect();

      state.loadingObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const mediaEl = entry.target.querySelector('.youtube-player, .native-player');
              if (mediaEl) initMedia(mediaEl.id);
            }
          });
        },
        { root: scroller, rootMargin: '50% 0px 50% 0px' }
      );

      state.playbackObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const mediaEl = entry.target.querySelector('.youtube-player, .native-player');
            if (!mediaEl) return;

            if (mediaEl.dataset.kind === 'youtube') {
              const player = state.players[mediaEl.id];
              if (entry.isIntersecting) {
                if (player && typeof player.playVideo === 'function') {
                  player.playVideo();
                  if (state.soundUnlocked && typeof player.unMute === 'function') player.unMute();
                }
              } else if (player && typeof player.pauseVideo === 'function') {
                player.pauseVideo();
              }
            } else {
              if (entry.isIntersecting) {
                if (mediaEl.dataset.src && !mediaEl.getAttribute('src')) mediaEl.src = mediaEl.dataset.src;
                if (state.soundUnlocked) mediaEl.muted = false;
                // Actual playback starting is the strongest signal the video is ready.
                mediaEl
                  .play()
                  .then(() => markLoaded(mediaEl.id))
                  .catch(() => {
                    // Autoplay-with-sound was blocked; fall back to muted so playback doesn't stall.
                    mediaEl.muted = true;
                    mediaEl
                      .play()
                      .then(() => markLoaded(mediaEl.id))
                      .catch(() => {});
                  });
              } else {
                mediaEl.pause();
              }
            }
          });
        },
        { root: scroller, rootMargin: '0px', threshold: 0.6 }
      );

      state.urlObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const videoId = entry.target.getAttribute('data-video-id');
              if (videoId) {
                const url = watchUrl(videoId);
                if (WIN.location.pathname !== url.pathname) {
                  WIN.history.replaceState({}, '', url);
                }
              }
              const idx = parseInt(entry.target.getAttribute('data-index') || '0', 10);
              state.currentIndex = idx;
              cleanupDistantMedia(idx);
              maybeLoadMore(idx);
              pruneDistantSections(idx);
            }
          });
        },
        { root: scroller, threshold: 0.7 }
      );

      document.querySelectorAll('.clip-section').forEach((section) => {
        state.loadingObserver.observe(section);
        state.playbackObserver.observe(section);
        state.urlObserver.observe(section);
      });

      // Wired once per scroller element (it's reused across opens/resets), not per call.
      // No rAF/timer throttling: the check itself is a couple of arithmetic ops, and
      // scroll events on mobile are already coalesced by the browser, so it's cheap
      // enough to just run directly and not depend on the paint pipeline at all.
      if (!scroller.dataset.infiniteScrollWired) {
        scroller.dataset.infiniteScrollWired = '1';
        scroller.addEventListener('scroll', () => checkScrollLoadMore(scroller), { passive: true });
      }
      // Also run once immediately in case the initial batch doesn't fill the viewport
      // (e.g. a very tall screen) — nothing to scroll to would mean no scroll event ever fires.
      checkScrollLoadMore(scroller);
    }

    // --- VIEWER OPEN/CLOSE ---
    function openViewer(index) {
      const overlay = document.getElementById('clip-viewer-overlay');
      const scroller = document.getElementById('viewer-scroller');
      const target = document.getElementById('clip-section-' + index);
      if (!overlay || !scroller) return;

      if (target) scroller.scrollTop = target.offsetTop;

      document.body.classList.add('clip-viewer-open');
      overlay.classList.add('active');
      attachObservers(scroller);
    }

    function closeViewer() {
      const overlay = document.getElementById('clip-viewer-overlay');
      document.body.classList.remove('clip-viewer-open');
      overlay?.classList.remove('active');
      unloadAllMedia();
    }

    function closeViewerAndUpdateUrl() {
      // A direct /clip/{id} link never rendered the gallery behind the viewer (see
      // showGallery in the frontmatter), so there's nothing to reveal by just hiding the
      // overlay — send the user to a real /clips load instead.
      if (!document.getElementById('clips-grid') && !document.querySelector('.clips-hero')) {
        WIN.location.href = '/clips';
        return;
      }
      closeViewer();
      const url = new URL(WIN.location.href);
      url.pathname = '/clips';
      WIN.history.replaceState({}, '', url);
    }

    function getClipIndexByVideoId(videoId) {
      const section = document.querySelector('.clip-section[data-video-id="' + CSS.escape(videoId) + '"]');
      return section ? parseInt(section.getAttribute('data-index') || '0', 10) : null;
    }

    // --- GALLERY -> VIEWER WIRING ---
    function initGallery() {
      const grid = document.getElementById('clips-grid');
      if (grid && !grid.dataset.wired) {
        grid.dataset.wired = '1';
        grid.addEventListener('click', (e) => {
          const card = e.target.closest('.clip-card');
          if (!card) return;
          e.preventDefault();
          state.soundUnlocked = true;
          const videoId = card.getAttribute('data-video-id');
          if (!videoId) return;
          WIN.history.pushState({}, '', watchUrl(videoId));
          const existingIndex = getClipIndexByVideoId(videoId);
          if (existingIndex !== null) {
            openViewer(existingIndex);
          } else {
            resetViewerTo(videoId);
          }
        });
      }

      document.querySelectorAll('.clips-tab').forEach((chip) => {
        chip.onclick = () => {
          document.querySelectorAll('.clips-tab').forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          const filter = chip.getAttribute('data-filter');
          document.querySelectorAll('.clip-card').forEach((card) => {
            const show = filter === 'all' || card.getAttribute('data-episode-slug') === filter;
            card.classList.toggle('is-hidden', !show);
          });
        };
      });
    }

    const closeBtn = document.getElementById('viewer-close-btn');
    if (closeBtn) {
      closeBtn.onclick = () => closeViewerAndUpdateUrl();
    }

    // Delegated so interaction layers built later by appendClips() work without rewiring.
    if (!WIN._clipsInteractionDelegated) {
      WIN._clipsInteractionDelegated = true;
      document.addEventListener('click', (e) => {
        const layer = e.target.closest('.interaction-layer');
        if (!layer) return;
        const targetId = layer.getAttribute('data-target');
        if (targetId) togglePlay(targetId);
      });
    }

    WIN.addEventListener('popstate', () => {
      const watch = getWatchIdFromLocation();
      const overlay = document.getElementById('clip-viewer-overlay');
      const scroller = document.getElementById('viewer-scroller');
      if (!watch) {
        if (overlay && overlay.classList.contains('active')) closeViewer();
        return;
      }
      const index = getClipIndexByVideoId(watch);
      if (index === null) {
        resetViewerTo(watch);
        return;
      }
      if (!overlay || !scroller) return;
      if (!overlay.classList.contains('active')) {
        document.body.classList.add('clip-viewer-open');
        overlay.classList.add('active');
        attachObservers(scroller);
      }
      const target = document.getElementById('clip-section-' + index);
      if (target) scroller.scrollTop = target.offsetTop;
    });

    // --- GLOBAL ACTIONS (for onclick) ---
    WIN.handleLikeClip = async function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }

      const clipId = btn.getAttribute('data-clip-id');
      if (!clipId) return;

      const isLiked = btn.classList.contains('liked');

      if (isLiked) {
        btn.classList.remove('liked');
      } else {
        btn.classList.add('liked');
        btn
          .querySelector('.reel-action-icon')
          ?.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.25)' }, { transform: 'scale(1)' }], { duration: 200 });
      }

      try {
        const res = await fetch('/api/clips/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clipId }),
        });
        if (res.status === 401) {
          WIN.location.href = '/login';
          return;
        }
      } catch (e) {
        console.error(e);
        btn.classList.toggle('liked', isLiked);
      }
    };

    WIN.handleShareClip = function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }
      const clipId = btn.getAttribute('data-clip-id');
      if (!clipId) return;
      const url = watchUrl(clipId);

      const iconWrap = btn.querySelector('.reel-action-icon');
      const label = btn.querySelector('.reel-action-label');
      if (!iconWrap || !label) return;

      navigator.clipboard.writeText(url.toString()).then(() => {
        const originalIcon = iconWrap.innerHTML;
        const originalLabel = label.textContent;
        iconWrap.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        label.textContent = 'Copiado';
        setTimeout(() => {
          iconWrap.innerHTML = originalIcon;
          label.textContent = originalLabel;
        }, 2000);
      });
    };

    // --- EPISODE CLIPS SIDE PANEL ---
    WIN.handleOpenEpisodeClips = function (btn) {
      if (WIN.event) {
        WIN.event.stopPropagation();
        WIN.event.preventDefault();
      }

      const slug = btn.getAttribute('data-episode-slug');
      if (!slug || !WIN._clipsByEpisode) return;

      const episodeData = WIN._clipsByEpisode[slug];
      if (!episodeData || !episodeData.clips || episodeData.clips.length === 0) return;

      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      const grid = document.getElementById('panel-clips-grid');
      const titleEl = document.getElementById('panel-episode-title');
      const imageEl = document.getElementById('panel-episode-image');
      const countEl = document.getElementById('panel-clips-count');
      if (!panel || !grid || !titleEl || !imageEl || !countEl || !backdrop) return;

      const currentWatch = getWatchIdFromLocation();

      titleEl.textContent = episodeData.episodeTitle;
      imageEl.src = episodeData.episodeImage;
      imageEl.alt = episodeData.episodeTitle;
      countEl.textContent = episodeData.clips.length + ' clips';

      grid.innerHTML = episodeData.clips
        .map((clip, i) => {
          const isActive = clip.videoId === currentWatch;
          const delay = (i * 0.06).toFixed(2);
          return (
            '<a class="grid-clip-card' +
            (isActive ? ' active-clip' : '') +
            '" href="/clip/' +
            encodeURIComponent(clip.videoId || '') +
            '" style="animation-delay:' +
            delay +
            's">' +
            '<span class="grid-clip-badge">' +
            (i + 1) +
            '</span>' +
            '<img src="' +
            (clip.thumbnail || '') +
            '" alt="" loading="lazy" />' +
            '<div class="grid-play-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg></div>' +
            '<div class="grid-clip-info">' +
            '<div class="grid-clip-title">' +
            clip.title +
            '</div>' +
            '</div>' +
            '</a>'
          );
        })
        .join('');

      panel.classList.add('active');
      backdrop.classList.add('active');
    };

    WIN.handleCloseEpisodeClips = function () {
      const panel = document.getElementById('episode-clips-panel');
      const backdrop = document.getElementById('episode-panel-backdrop');
      if (panel) panel.classList.remove('active');
      if (backdrop) backdrop.classList.remove('active');
    };

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      const panel = document.getElementById('episode-clips-panel');
      if (panel && panel.classList.contains('active')) {
        WIN.handleCloseEpisodeClips();
        return;
      }
      const overlay = document.getElementById('clip-viewer-overlay');
      if (overlay && overlay.classList.contains('active')) {
        closeViewerAndUpdateUrl();
      }
    });

    async function loadLikes() {
      try {
        const res = await fetch('/api/clips/liked');
        if (res.ok) {
          const data = await res.json();
          state.likedIds = new Set(data.likedClips || []);
          applyLikedState();
        }
      } catch (e) {
        console.error(e);
      }
    }

    // Marks .like-btn elements as liked based on the cached set from loadLikes(); called
    // again after appendClips() so sections added while scrolling get the right state too.
    function applyLikedState() {
      if (!state.likedIds) return;
      document.querySelectorAll('.like-btn').forEach((btn) => {
        const cid = btn.getAttribute('data-clip-id');
        if (cid && state.likedIds.has(cid)) {
          btn.classList.add('liked');
        }
      });
    }

    // --- INIT ---
    function initPage() {
      if (!document.getElementById('clips-grid') && !document.getElementById('clip-viewer-overlay')) return;

      Object.values(state.players).forEach((p) => {
        if (p && typeof p.destroy === 'function') {
          try {
            p.destroy();
          } catch (e) {}
        }
      });
      state.players = {};
      state.loadedCount = document.querySelectorAll('.clip-section').length;
      state.feedCursor = state.loadedCount;

      initGallery();
      loadLikes();

      const watchId = getWatchIdFromLocation();
      if (watchId) {
        const index = getClipIndexByVideoId(watchId);
        if (index !== null) {
          openViewer(index);
        } else {
          resetViewerTo(watchId);
        }
      }
    }

    if (!WIN._clipsPageLoadRegistered) {
      WIN._clipsPageLoadRegistered = true;
      document.addEventListener('astro:page-load', initPage);
    }

    initPage();
  })();
</script>
