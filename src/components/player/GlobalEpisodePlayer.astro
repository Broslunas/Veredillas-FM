<!--
  Global persistent episode player.
  Rendered by Layout.astro on every page with transition:persist so playback
  survives Astro client-side navigations away from /ep/[slug].

  Contract (already wired up elsewhere in the codebase before this component
  existed):
    - document dispatches "veredillas:play-episode" with
      { audioUrl, title, author, cover, slug, href, autoplay } from
      src/components/EpisodeCard.astro (quick-play buttons, autoplay: true)
      and src/pages/ep/[slug].astro (passive page-load registration,
      autoplay: false - ignored here for playback, the in-page player handles
      that visit).
    - On "astro:before-preparation" (about to navigate away), if
      #netflix-video-element (src/components/player/NetflixPlayer.tsx) is
      playing, its state is handed off to this element so playback continues.
    - window.VeredillasGlobalPlayer.getEpisodeState()/releaseEpisode(slug)
      let NetflixPlayer take playback back when the user returns to the
      episode's own page.
-->
<div id="global-episode-player-root" transition:persist>
    <div id="gep-widget" class="gep-widget hidden" role="region" aria-label="Episodio (reproductor flotante)">
        <a class="gep-media" id="gep-media-link" href="#" aria-label="Volver al episodio">
            <video id="global-episode-player" playsinline preload="none"></video>
            <img id="gep-cover" class="gep-cover" alt="" />
            <span class="gep-audio-icon" aria-hidden="true">
                <span class="gep-eq-bar"></span>
                <span class="gep-eq-bar"></span>
                <span class="gep-eq-bar"></span>
            </span>
        </a>

        <div class="gep-body">
            <a href="#" id="gep-title-link" class="gep-meta">
                <strong id="gep-title">Episodio</strong>
                <small id="gep-author">Veredillas FM</small>
            </a>

            <div class="gep-progress" id="gep-progress">
                <div class="gep-progress-fill" id="gep-progress-fill"></div>
            </div>

            <div class="gep-controls">
                <button id="gep-toggle" class="gep-icon-btn gep-toggle" aria-label="Reproducir/Pausar" type="button">
                    <svg class="gep-icon-play" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                    <svg class="gep-icon-pause" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>
                <button id="gep-mute" class="gep-icon-btn" aria-label="Silenciar/Activar sonido" type="button">
                    <svg class="gep-icon-vol-high" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                    <svg class="gep-icon-vol-muted" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                </button>
                <button id="gep-close" class="gep-icon-btn gep-close" aria-label="Cerrar" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .gep-widget {
        position: fixed;
        right: 16px;
        bottom: 84px;
        z-index: 9499;
        display: flex;
        align-items: center;
        gap: 10px;
        width: 300px;
        max-width: calc(100vw - 24px);
        padding: 8px;
        border-radius: 16px;
        background: rgba(10, 10, 12, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(14px);
    }

    .gep-widget.hidden {
        display: none;
    }

    .gep-widget.visible {
        display: flex;
        animation: gepSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes gepSlideIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .gep-media {
        position: relative;
        flex-shrink: 0;
        width: 64px;
        height: 64px;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
        display: block;
    }

    #global-episode-player {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .gep-cover {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .gep-audio-icon {
        position: absolute;
        inset: 0;
        display: none;
        align-items: flex-end;
        justify-content: center;
        gap: 3px;
        padding-bottom: 8px;
        background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 60%);
    }

    .gep-eq-bar {
        width: 3px;
        height: 8px;
        border-radius: 2px;
        background: var(--color-primary, #8b5cf6);
        animation: gepEq 1s ease-in-out infinite;
    }
    .gep-eq-bar:nth-child(2) { animation-delay: 0.15s; height: 14px; }
    .gep-eq-bar:nth-child(3) { animation-delay: 0.3s; height: 10px; }

    @keyframes gepEq {
        0%, 100% { transform: scaleY(0.5); }
        50% { transform: scaleY(1.3); }
    }

    /* Video content: show the frame, hide the cover/audio icon */
    .gep-widget.is-video #global-episode-player { display: block; }
    .gep-widget.is-video .gep-cover,
    .gep-widget.is-video .gep-audio-icon { display: none; }

    /* Audio-only content: hide the (blank) video frame, show cover + icon */
    .gep-widget:not(.is-video) #global-episode-player { display: none; }
    .gep-widget:not(.is-video) .gep-cover { display: block; }
    .gep-widget:not(.is-video) .gep-audio-icon { display: flex; }

    .gep-body {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        flex: 1;
    }

    .gep-meta {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
        text-decoration: none;
        min-width: 0;
    }

    .gep-meta strong {
        font-size: 0.78rem;
        font-weight: 700;
        color: white;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .gep-meta small {
        font-size: 0.68rem;
        color: #a1a1aa;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .gep-progress {
        height: 4px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        cursor: pointer;
        overflow: hidden;
    }

    .gep-progress-fill {
        height: 100%;
        width: 0%;
        background: var(--color-primary, #8b5cf6);
        border-radius: 999px;
    }

    .gep-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .gep-icon-btn {
        flex-shrink: 0;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.08);
        color: #d4d4d8;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .gep-icon-btn:hover {
        background: rgba(255, 255, 255, 0.16);
        color: white;
    }

    .gep-toggle {
        background: var(--color-primary, #8b5cf6);
        color: white;
    }

    .gep-toggle:hover {
        filter: brightness(1.15);
    }

    .gep-close {
        margin-left: auto;
    }

    .gep-close:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #fca5a5;
    }

    @media (max-width: 640px) {
        .gep-widget {
            right: 12px;
            left: 12px;
            bottom: 148px;
            width: auto;
        }
    }
</style>

<script>
    (function () {
        const WIN = window as any;
        if (WIN.__gepInited) return;
        WIN.__gepInited = true;

        const video = document.getElementById('global-episode-player') as HTMLVideoElement | null;
        const widget = document.getElementById('gep-widget');
        const cover = document.getElementById('gep-cover') as HTMLImageElement | null;
        const mediaLink = document.getElementById('gep-media-link') as HTMLAnchorElement | null;
        const titleLink = document.getElementById('gep-title-link') as HTMLAnchorElement | null;
        const titleEl = document.getElementById('gep-title');
        const authorEl = document.getElementById('gep-author');
        const progress = document.getElementById('gep-progress');
        const progressFill = document.getElementById('gep-progress-fill') as HTMLElement | null;
        const toggleBtn = document.getElementById('gep-toggle');
        const muteBtn = document.getElementById('gep-mute');
        const closeBtn = document.getElementById('gep-close');

        if (!video || !widget) return;

        const iconPlay = toggleBtn?.querySelector('.gep-icon-play') as HTMLElement;
        const iconPause = toggleBtn?.querySelector('.gep-icon-pause') as HTMLElement;
        const iconVolHigh = muteBtn?.querySelector('.gep-icon-vol-high') as HTMLElement;
        const iconVolMuted = muteBtn?.querySelector('.gep-icon-vol-muted') as HTMLElement;

        interface EpisodeMeta {
            slug: string;
            href: string;
            title: string;
            author: string;
            cover: string;
            isVideo: boolean;
        }

        let meta: EpisodeMeta | null = null;
        let active = false;
        let userClosed = false;

        function normalizedPath(p: string) {
            return p.replace(/\/$/, '') || '/';
        }

        function isOnActiveEpisodePage() {
            if (!meta?.href) return false;
            return normalizedPath(window.location.pathname) === normalizedPath(meta.href);
        }

        function updatePlayIcon() {
            const playing = !video!.paused;
            if (iconPlay) iconPlay.style.display = playing ? 'none' : 'block';
            if (iconPause) iconPause.style.display = playing ? 'block' : 'none';
        }

        function updateMuteIcon() {
            if (iconVolHigh) iconVolHigh.style.display = video!.muted ? 'none' : 'block';
            if (iconVolMuted) iconVolMuted.style.display = video!.muted ? 'block' : 'none';
        }

        function updateVisibility() {
            const shouldShow = active && !userClosed && !isOnActiveEpisodePage();
            widget!.classList.toggle('visible', shouldShow);
            widget!.classList.toggle('hidden', !shouldShow);
        }

        function applyMeta() {
            if (!meta) return;
            if (titleEl) titleEl.textContent = meta.title || 'Episodio';
            if (authorEl) authorEl.textContent = meta.author || 'Veredillas FM';
            if (cover) cover.src = meta.cover || '/logo.webp';
            if (mediaLink) mediaLink.href = meta.href || '/ep';
            if (titleLink) titleLink.href = meta.href || '/ep';
            widget!.classList.toggle('is-video', Boolean(meta.isVideo));
        }

        function loadAndPlay(opts: {
            src: string;
            currentTime?: number;
            isVideo: boolean;
            slug: string;
            href: string;
            title: string;
            author: string;
            cover: string;
        }) {
            if (!opts.src) return;

            meta = {
                slug: opts.slug,
                href: opts.href,
                title: opts.title,
                author: opts.author,
                cover: opts.cover,
                isVideo: opts.isVideo,
            };
            active = true;
            userClosed = false;
            applyMeta();

            const targetTime = opts.currentTime || 0;
            const start = () => {
                if (targetTime > 0) {
                    try { video!.currentTime = targetTime; } catch (e) {}
                }
                video!.play().catch(() => {});
            };

            if (video!.getAttribute('src') !== opts.src) {
                video!.src = opts.src;
                video!.addEventListener('loadedmetadata', start, { once: true });
            } else if (video!.readyState >= 1) {
                start();
            } else {
                video!.addEventListener('loadedmetadata', start, { once: true });
            }

            updateVisibility();
        }

        function takeOverFromInPagePlayer() {
            const inPageVideo = document.getElementById('netflix-video-element') as HTMLVideoElement | null;
            if (!inPageVideo || inPageVideo.paused || inPageVideo.ended) return;

            const src = inPageVideo.currentSrc || inPageVideo.src;
            if (!src) return;

            loadAndPlay({
                src,
                currentTime: inPageVideo.currentTime,
                isVideo: inPageVideo.dataset.isVideo === 'true',
                slug: inPageVideo.dataset.slug || '',
                href: inPageVideo.dataset.href || '',
                title: inPageVideo.dataset.title || '',
                author: inPageVideo.dataset.author || '',
                cover: inPageVideo.poster || '',
            });

            inPageVideo.pause();
        }

        // --- Public contract for NetflixPlayer.tsx (reverse handoff) ---
        WIN.VeredillasGlobalPlayer = {
            getEpisodeState() {
                if (!active || !meta) return null;
                return {
                    slug: meta.slug,
                    currentTime: video!.currentTime,
                    paused: video!.paused,
                    src: video!.currentSrc,
                    isVideo: meta.isVideo,
                };
            },
            releaseEpisode(slug: string) {
                if (!meta || meta.slug !== slug) return;
                video!.pause();
                active = false;
                updateVisibility();
            },
        };

        // --- veredillas:play-episode contract (quick-play + page registration) ---
        document.addEventListener('veredillas:play-episode', (e: any) => {
            const d = e.detail;
            if (!d || !d.autoplay || !d.audioUrl) return;
            loadAndPlay({
                src: d.audioUrl,
                currentTime: 0,
                isVideo: false,
                slug: d.slug || '',
                href: d.href || '',
                title: d.title || '',
                author: d.author || '',
                cover: d.cover || '',
            });
        });

        // --- Handoff away from /ep/[slug] ---
        document.addEventListener('astro:before-preparation', takeOverFromInPagePlayer);
        document.addEventListener('astro:after-swap', updateVisibility);

        // --- Widget controls ---
        video.addEventListener('play', updatePlayIcon);
        video.addEventListener('pause', updatePlayIcon);
        video.addEventListener('volumechange', updateMuteIcon);
        video.addEventListener('timeupdate', () => {
            if (progressFill && video!.duration) {
                progressFill.style.width = `${(video!.currentTime / video!.duration) * 100}%`;
            }
        });

        toggleBtn?.addEventListener('click', () => {
            if (video!.paused) video!.play().catch(() => {});
            else video!.pause();
        });

        muteBtn?.addEventListener('click', () => {
            video!.muted = !video!.muted;
            updateMuteIcon();
        });

        progress?.addEventListener('click', (e: MouseEvent) => {
            if (!video!.duration) return;
            const rect = (progress as HTMLElement).getBoundingClientRect();
            const pct = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
            video!.currentTime = pct * video!.duration;
        });

        closeBtn?.addEventListener('click', () => {
            video!.pause();
            userClosed = true;
            updateVisibility();
        });

        updatePlayIcon();
        updateMuteIcon();
        updateVisibility();
    })();
</script>
