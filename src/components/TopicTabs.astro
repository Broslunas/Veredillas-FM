---
import EpisodeCard from './EpisodeCard.astro';
import type { CollectionEntry } from '@/lib/content';

interface TopicGroup {
    id: string;
    label: string;
    badgeText: string;
    colorClass: string; // e.g. 'text-primary'
    bgClass: string; // e.g. 'bg-primary'
    episodes: CollectionEntry<'episodios'>[];
}

interface Props {
    groups: TopicGroup[];
}

const { groups } = Astro.props;
---

<section class="topic-tabs py-16 md:py-24 border-t border-white/5 overflow-hidden">
    <div class="container">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-8 gs-fade-up">
            <div class="space-y-4">
                <div class="flex items-center gap-3 text-primary font-black tracking-[0.3em] uppercase text-[0.65rem] md:text-xs">
                    <span class="w-12 h-[2px] bg-primary rounded-full"></span>
                    Explora por tema
                </div>
                <h2 class="text-4xl md:text-6xl font-black text-white leading-[0.9] tracking-tighter">
                    Voces de <span class="text-gradient">Veredillas</span>
                </h2>
                <p class="text-zinc-400 text-lg">Elige el tema y descubre lo que se está contando</p>
            </div>

            <div class="topic-pills flex flex-wrap items-center gap-2 bg-white/5 p-1.5 rounded-full border border-white/10 backdrop-blur-sm">
                {groups.map((group, i) => (
                    <button
                        type="button"
                        class:list={["topic-pill px-4 py-2.5 rounded-full text-sm font-bold transition-colors bg-transparent border-none cursor-pointer text-zinc-400 hover:text-white", { "active text-white": i === 0 }]}
                        data-tab-target={group.id}
                        data-bg-class={group.bgClass}
                        style={i === 0 ? `background: var(--color-${group.bgClass.replace('bg-', '')})` : ''}
                    >
                        {group.label}
                    </button>
                ))}
            </div>
        </div>

        {groups.map((group, i) => (
            <div class:list={["topic-panel", { hidden: i !== 0 }]} data-tab-panel={group.id}>
                <div class={`flex items-center gap-3 ${group.colorClass} font-black tracking-[0.3em] uppercase text-[0.65rem] mb-6`}>
                    <span class={`w-8 h-[2px] ${group.bgClass} rounded-full`}></span>
                    {group.badgeText}
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {group.episodes.slice(0, 6).map((post) => (
                        <EpisodeCard post={post} />
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .topic-pill.active {
        color: white;
        box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.5);
    }
</style>

<script>
    import { gsap } from 'gsap';

    const initTopicTabs = () => {
        document.querySelectorAll('.topic-tabs').forEach((section) => {
            const el = section as HTMLElement;
            if (el.dataset.tabsInited) return;
            el.dataset.tabsInited = 'true';

            const pills = Array.from(el.querySelectorAll<HTMLButtonElement>('.topic-pill'));
            const panels = Array.from(el.querySelectorAll<HTMLElement>('.topic-panel'));

            pills.forEach((pill) => {
                pill.addEventListener('click', () => {
                    if (pill.classList.contains('active')) return;
                    const targetId = pill.dataset.tabTarget;
                    const targetPanel = panels.find((p) => p.dataset.tabPanel === targetId);
                    const currentPanel = panels.find((p) => !p.classList.contains('hidden'));
                    if (!targetPanel || targetPanel === currentPanel) return;

                    pills.forEach((p) => {
                        p.classList.remove('active');
                        p.style.background = '';
                    });
                    pill.classList.add('active');
                    const bgClass = pill.dataset.bgClass?.replace('bg-', '');
                    if (bgClass) pill.style.background = `var(--color-${bgClass})`;

                    const finishSwap = () => {
                        if (currentPanel) currentPanel.classList.add('hidden');
                        targetPanel.classList.remove('hidden');
                        gsap.fromTo(
                            targetPanel.children,
                            { opacity: 0, y: 16 },
                            { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: 'power2.out' }
                        );
                    };

                    if (currentPanel) {
                        gsap.to(currentPanel, {
                            opacity: 0,
                            y: -10,
                            duration: 0.25,
                            ease: 'power2.in',
                            onComplete: () => {
                                gsap.set(currentPanel, { opacity: '', y: '' });
                                finishSwap();
                            },
                        });
                    } else {
                        finishSwap();
                    }
                });
            });
        });
    };

    document.addEventListener('DOMContentLoaded', initTopicTabs);
    document.addEventListener('astro:page-load', initTopicTabs);
</script>
