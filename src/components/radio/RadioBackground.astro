<!-- Ambient studio backdrop. Reacts to the stream through --bass-scale / --rd-energy -->
<div class="radio-bg" aria-hidden="true">
    <div class="rb-orb rb-orb-1"></div>
    <div class="rb-orb rb-orb-2"></div>
    <div class="rb-orb rb-orb-3"></div>

    <div class="rb-grid"></div>
    <div class="rb-beam"></div>
    <div class="rb-vignette"></div>
</div>

<style>
    .radio-bg {
        position: fixed;
        inset: 0;
        z-index: -10;
        overflow: hidden;
        pointer-events: none;
        background: var(--color-bg);
    }

    .rb-orb {
        position: absolute;
        border-radius: 9999px;
        filter: blur(120px);
        transform: scale(var(--bass-scale, 1));
        transition: transform 0.08s ease-out, opacity 0.9s ease;
        will-change: transform;
        opacity: calc(0.35 + var(--rd-energy, 0) * 0.45);
    }

    .rb-orb-1 {
        top: -18rem;
        left: -12rem;
        width: 42rem;
        height: 42rem;
        background: rgba(var(--color-primary-rgb), 0.5);
        animation: rb-drift 16s ease-in-out infinite alternate;
    }

    .rb-orb-2 {
        top: 18%;
        right: -16rem;
        width: 40rem;
        height: 40rem;
        background: rgba(var(--color-secondary-rgb), 0.42);
        animation: rb-drift 20s ease-in-out infinite alternate-reverse;
    }

    .rb-orb-3 {
        bottom: -22rem;
        left: 32%;
        width: 36rem;
        height: 36rem;
        background: rgba(var(--color-accent-rgb), 0.28);
        animation: rb-drift 24s ease-in-out infinite alternate;
    }

    /* Fine studio grid, faded towards the edges */
    .rb-grid {
        position: absolute;
        inset: 0;
        opacity: 0.05;
        background-image:
            linear-gradient(to right, white 1px, transparent 1px),
            linear-gradient(to bottom, white 1px, transparent 1px);
        background-size: 72px 72px;
        -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 30%, black 0%, transparent 78%);
        mask-image: radial-gradient(ellipse 75% 60% at 50% 30%, black 0%, transparent 78%);
    }

    /* Slow sweeping light, like a studio spotlight */
    .rb-beam {
        position: absolute;
        top: -30%;
        left: 50%;
        width: 120vw;
        height: 160vh;
        margin-left: -60vw;
        background: conic-gradient(
            from 180deg at 50% 0%,
            transparent 0deg,
            rgba(var(--color-primary-rgb), 0.16) 24deg,
            transparent 60deg,
            transparent 300deg,
            rgba(var(--color-secondary-rgb), 0.14) 336deg,
            transparent 360deg
        );
        opacity: calc(0.35 + var(--rd-energy, 0) * 0.5);
        transition: opacity 0.9s ease;
        animation: rb-sweep 40s linear infinite;
    }

    .rb-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 30%, transparent 30%, var(--color-bg) 92%);
    }

    @keyframes rb-drift {
        from { translate: 0 0; }
        to   { translate: 60px 48px; }
    }

    @keyframes rb-sweep {
        from { rotate: 0deg; }
        to   { rotate: 360deg; }
    }

    [data-theme="light"] .rb-grid {
        background-image:
            linear-gradient(to right, black 1px, transparent 1px),
            linear-gradient(to bottom, black 1px, transparent 1px);
        opacity: 0.04;
    }

    @media (prefers-reduced-motion: reduce) {
        .rb-orb,
        .rb-beam {
            animation: none;
            transition: none;
            transform: none;
        }
    }
</style>
