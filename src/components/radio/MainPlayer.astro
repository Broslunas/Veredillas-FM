---
import VolumeBar from './VolumeBar.astro';

interface Props {
    isRegistered: boolean;
}

const { isRegistered } = Astro.props;
---

<div class="premiere-countdown relative w-full lg:flex-1 max-w-3xl min-h-[500px] rounded-[2rem] border border-white/10 has-[.music-btn.playing]:border-primary/40 bg-gradient-to-b from-white/[0.05] to-black/50 backdrop-blur-2xl p-8 sm:p-12 flex flex-col items-center justify-center text-center overflow-hidden shadow-[0_25px_60px_-15px_rgba(0,0,0,0.6)] has-[.music-btn.playing]:shadow-[0_0_90px_-20px_rgba(139,92,246,0.45),0_25px_60px_-15px_rgba(0,0,0,0.6)] transition-shadow duration-700 ease-out">

    <!-- Top glow line -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/60 to-transparent opacity-70"></div>

    <!-- Inner ambient glow -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(139,92,246,0.2)_0%,transparent_65%)] pointer-events-none"></div>

    <!-- Utility toolbar -->
    <div class="absolute top-5 right-5 sm:top-6 sm:right-6 flex items-center gap-2 z-[100]">
        <button class="share-btn flex items-center justify-center w-11 h-11 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all backdrop-blur-md" title="Compartir a Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
        </button>
        <button class="cinema-toggle-btn flex items-center justify-center w-11 h-11 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all backdrop-blur-md" title="Modo Cine">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
        </button>
        <button class="voice-toggle-btn enabled [&.enabled]:border-primary [&.enabled]:text-primary [&.enabled]:bg-primary/10 flex items-center justify-center w-11 h-11 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 transition-all backdrop-blur-md" aria-label="Activar/Desactivar voz de locutor" title="Locutor: ON">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mic"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
    </div>

    <div class="countdown-content relative w-full flex flex-col items-center gap-7 sm:gap-8">

        <!-- Share Card Template (Hidden, rendered off-screen to PNG for Instagram Stories) -->
        <div id="share-card-template" class="absolute top-[-9999px] left-[-9999px] w-[1080px] h-[1920px] bg-gradient-to-br from-[#0b0b10] via-[#111116] to-[#050506] flex flex-col items-center justify-center text-white overflow-hidden z-[-1]">
            <div class="absolute inset-0 opacity-70 pointer-events-none">
                <div class="absolute top-[6%] left-[-12%] w-[900px] h-[900px] rounded-full bg-primary/40 blur-[180px]"></div>
                <div class="absolute bottom-[4%] right-[-16%] w-[900px] h-[900px] rounded-full bg-secondary/30 blur-[180px]"></div>
            </div>
            <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;"></div>

            <img src="/logo.webp" width="220" class="mb-20 z-10 drop-shadow-[0_0_30px_rgba(139,92,246,0.4)]" />
            <h2 class="text-8xl font-display font-extrabold mb-14 text-center px-16 z-10 bg-gradient-to-b from-white to-gray-400 bg-clip-text text-transparent tracking-tight">Veredillas FM</h2>
            <div class="bg-white/[0.06] backdrop-blur-2xl border border-white/15 p-16 rounded-[4rem] w-[82%] max-w-[900px] flex flex-col items-center shadow-[0_40px_80px_rgba(0,0,0,0.6)] z-10">
                <div class="flex items-center gap-3 mb-8">
                    <span class="w-4 h-4 rounded-full bg-primary"></span>
                    <p class="text-3xl text-gray-300 uppercase tracking-[0.2em] font-bold">Sonando ahora</p>
                </div>
                <h3 class="text-6xl font-display font-extrabold text-center bg-gradient-to-r from-cyan-300 to-violet-400 bg-clip-text text-transparent" id="share-song-title">Cargando...</h3>
            </div>
            <p class="absolute bottom-28 text-4xl font-semibold text-gray-400 z-10 tracking-wide">radio.veredillasfm.es</p>
        </div>

        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[0.68rem] font-bold uppercase tracking-[0.15em] text-gray-300">
            <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-primary opacity-75 animate-ping"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            Radio en directo · 24/7
        </div>

        <div>
            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold bg-gradient-to-b from-white to-gray-400 bg-clip-text text-transparent tracking-tight drop-shadow-lg">
                Veredillas FM
            </h1>
            <p class="mt-3 text-sm sm:text-base text-gray-400 max-w-sm mx-auto">
                La radio hecha por y para los alumnos del IES Las Veredillas
            </p>
        </div>

        <!-- Play control -->
        <div class="relative flex flex-col items-center gap-5">
            <button class="music-btn music-toggle-btn group relative w-36 h-36 sm:w-44 sm:h-44 rounded-full flex items-center justify-center cursor-pointer" aria-label="Activar música de fondo">
                <span class="play-glow bass-reactive absolute inset-0 rounded-full bg-gradient-to-br from-primary to-secondary opacity-25 blur-2xl transition-opacity duration-700 group-[.playing]:opacity-70"></span>
                <span class="absolute inset-0 rounded-full border border-white/15 transition-all duration-500 group-[.playing]:border-primary/70 group-[.playing]:shadow-[0_0_50px_rgba(139,92,246,0.55)]"></span>
                <span class="absolute inset-[10px] rounded-full border border-white/10 group-[.playing]:animate-pulseGlow"></span>
                <span class="relative w-[calc(100%-32px)] h-[calc(100%-32px)] rounded-full bg-gradient-to-br from-white/[0.08] to-transparent border border-white/10 flex items-center justify-center transition-all duration-300 group-hover:scale-[1.04] group-active:scale-[0.97] group-[.playing]:bg-primary/15 group-[.playing]:border-primary/40">
                    <svg class="play-icon w-9 h-9 sm:w-10 sm:h-10 text-white translate-x-0.5 group-[.playing]:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>

                    <span class="equalizer hidden group-[.playing]:flex items-end h-8 gap-[5px]">
                        <span class="bar bar-1 w-[5px] bg-white rounded-full h-[10px] animate-eq"></span>
                        <span class="bar bar-2 w-[5px] bg-white rounded-full h-[22px] animate-eq" style="animation-delay:0.15s"></span>
                        <span class="bar bar-3 w-[5px] bg-white rounded-full h-[14px] animate-eq" style="animation-delay:0.3s"></span>
                        <span class="bar bar-4 w-[5px] bg-white rounded-full h-[8px] animate-eq" style="animation-delay:0.45s"></span>
                    </span>
                </span>
            </button>

            <span class="music-label text-sm sm:text-base font-bold uppercase tracking-[0.12em] text-gray-300">Activar Radio</span>
        </div>

        {isRegistered && (
            <div class="flex flex-wrap justify-center gap-3">
                <button class="import-song-trigger-btn flex items-center gap-2 bg-white/5 hover:bg-white/10 text-white px-5 sm:px-6 py-3 rounded-full font-semibold border border-white/10 hover:border-violet-400/40 transition-all shadow-[0_4px_20px_rgba(0,0,0,0.25)] hover:scale-[1.03] active:scale-95 cursor-pointer text-sm" id="import-song-trigger-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    Añadir canción
                </button>
                <button class="dj-trigger-btn flex items-center gap-2 bg-gradient-to-r from-primary to-violet-500 hover:brightness-110 text-white px-5 sm:px-6 py-3 rounded-full font-semibold border border-white/10 transition-all shadow-[0_4px_20px_rgba(139,92,246,0.35)] hover:scale-[1.03] active:scale-95 cursor-pointer text-sm" id="dj-trigger-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    Panel DJ
                </button>
            </div>
        )}

        <div class="w-full sm:w-auto sm:absolute sm:right-4 md:right-6 sm:top-1/2 sm:-translate-y-1/2 flex justify-center z-20">
            <VolumeBar />
        </div>

        <audio class="waiting-music" preload="none" loop crossorigin="anonymous" id="radio-audio">
            <source src="https://radio.veredillasfm.es/stream" type="audio/mpeg">
        </audio>
    </div>

    <div class="now-playing-corner fixed bottom-6 left-6 bg-[#0a0a0c]/90 backdrop-blur-xl border border-primary/30 rounded-2xl py-3.5 px-5 flex items-center gap-3.5 shadow-[0_15px_40px_rgba(0,0,0,0.6),inset_0_1px_1px_rgba(255,255,255,0.08)] translate-y-[150%] scale-90 opacity-0 transition-all duration-500 z-50 max-w-[320px] [&.visible]:translate-y-0 [&.visible]:scale-100 [&.visible]:opacity-100" id="now-playing-corner">
        <div class="now-playing-icon bg-primary/15 p-2.5 rounded-full flex items-center justify-center animate-pulseGlow shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </div>
        <div class="now-playing-info flex flex-col overflow-hidden">
            <div class="now-playing-label text-[0.65rem] uppercase text-primary tracking-[0.12em] font-extrabold mb-[3px]">Sonando en directo</div>
            <div class="now-playing-title text-[0.9rem] text-white whitespace-nowrap overflow-hidden text-ellipsis font-semibold drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]" id="corner-song-title">Ninguna canción</div>
        </div>
    </div>
</div>

<style>
    .play-glow {
        transform: scale(var(--bass-scale, 1));
        transition: transform 0.05s ease-out, opacity 0.7s ease;
        transform-origin: center;
        will-change: transform;
    }
</style>
