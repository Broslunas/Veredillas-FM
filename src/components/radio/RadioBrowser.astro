---
interface Props {
    isRegistered: boolean;
    isAdmin: boolean;
}

const { isRegistered, isAdmin } = Astro.props;

const tabs = [
    { id: 'queue', label: 'En cola', short: 'Cola' },
    { id: 'history', label: 'Ya sonó', short: 'Historial' },
    { id: 'library', label: 'Biblioteca', short: 'Biblioteca' },
];
---

<section id="cola" class="radio-browser flex min-h-0 flex-col overflow-hidden rounded-[1.75rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(0,0,0,0.4))] shadow-[0_40px_90px_-55px_rgba(0,0,0,0.9)] backdrop-blur-2xl">

    <!-- Tab bar -->
    <header class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-white/5 p-3 sm:p-4">
        <div class="rd-tabs" role="tablist" aria-label="Contenido de la emisora">
            {tabs.map((tab, i) => (
                <button
                    type="button"
                    class="rd-tab"
                    role="tab"
                    data-tab={tab.id}
                    aria-label={tab.label}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-controls={`rd-panel-${tab.id}`}
                >
                    <span class="max-sm:hidden">{tab.label}</span>
                    <span class="sm:hidden">{tab.short}</span>
                    <span class="rd-tab-count" id={`rd-count-${tab.id}`}>–</span>
                </button>
            ))}
        </div>

        {isAdmin && (
            <button
                type="button"
                id="dj-btn-clear-queue"
                class="rounded-lg px-3 py-1.5 text-xs font-bold text-red-400 transition-colors hover:bg-red-500/10 hover:text-red-300"
                data-only-tab="queue"
                title="Vaciar la cola de reproducción"
            >
                Vaciar cola
            </button>
        )}
    </header>

    <!-- Library toolbar (hidden unless the library tab is active) -->
    <div class="rd-toolbar hidden shrink-0 flex-col gap-3 border-b border-white/5 p-3 sm:p-4" id="rd-library-toolbar">
        <div class="relative">
            <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
                type="search"
                id="rd-library-search"
                placeholder="Buscar entre las canciones de la emisora…"
                autocomplete="off"
                class="w-full rounded-xl border border-white/10 bg-white/[0.04] py-2.5 pl-10 pr-3 text-sm text-white placeholder:text-gray-500 transition-colors focus:border-secondary/50 focus:bg-secondary/[0.06] focus:outline-none"
            />
        </div>
        <div class="rd-chip-scroll" id="rd-library-playlists"></div>
    </div>

    <!-- Panels -->
    <div class="min-h-0 flex-1">
        <div class="rd-panel rd-scroll" id="rd-panel-queue" role="tabpanel" data-panel="queue">
            <div class="rd-empty">
                <svg class="animate-spin text-gray-600" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                Conectando con la emisora…
            </div>
        </div>

        <div class="rd-panel rd-scroll hidden" id="rd-panel-history" role="tabpanel" data-panel="history">
            <div class="rd-empty">Todavía no ha sonado nada.</div>
        </div>

        <div class="rd-panel rd-scroll hidden" id="rd-panel-library" role="tabpanel" data-panel="library">
            <div class="rd-empty">Cargando biblioteca…</div>
        </div>
    </div>

    <footer class="shrink-0 border-t border-white/5 px-4 py-2.5 text-[0.68rem] text-gray-500" id="rd-browser-footer">
        {isRegistered
            ? 'Pide una canción desde la biblioteca o el Panel DJ.'
            : 'Inicia sesión para pedir canciones y añadirlas a la cola.'}
    </footer>
</section>

<style>
    .rd-tabs {
        display: inline-flex;
        gap: 0.25rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(0, 0, 0, 0.3);
        padding: 0.25rem;
    }

    .rd-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 9999px;
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-text-muted);
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.25s ease, color 0.25s ease;
    }
    .rd-tab:hover {
        color: var(--color-text-main);
        background: rgba(255, 255, 255, 0.05);
    }
    .rd-tab[aria-selected='true'] {
        background: rgba(var(--color-primary-rgb), 0.16);
        color: #fff;
        box-shadow: inset 0 0 0 1px rgba(var(--color-primary-rgb), 0.35);
    }

    .rd-tab-count {
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.08);
        padding: 0.05rem 0.4rem;
        font-size: 0.65rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-dim);
    }
    .rd-tab[aria-selected='true'] .rd-tab-count {
        background: rgba(var(--color-primary-rgb), 0.28);
        color: #fff;
    }

    .rd-chip-scroll {
        display: flex;
        gap: 0.4rem;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: none;
    }
    .rd-chip-scroll::-webkit-scrollbar {
        display: none;
    }

    .rd-panel {
        height: clamp(20rem, 46vh, 34rem);
        padding: 0.75rem;
    }
    @media (min-width: 640px) {
        .rd-panel {
            padding: 1rem;
        }
    }
</style>

<!-- Rows are rendered from JS, so their styles have to be global -->
<style is:global>
    .rd-scroll {
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.16) transparent;
    }
    .rd-scroll::-webkit-scrollbar {
        width: 8px;
    }
    .rd-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .rd-scroll::-webkit-scrollbar-thumb {
        border: 2px solid transparent;
        border-radius: 9999px;
        background-clip: content-box;
        background-color: rgba(255, 255, 255, 0.16);
    }
    .rd-scroll::-webkit-scrollbar-thumb:hover {
        background-color: rgba(var(--color-primary-rgb), 0.55);
    }

    .rd-empty {
        display: flex;
        height: 100%;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        padding: 1.5rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-text-dim);
    }
    .rd-empty--error {
        color: #f87171;
    }

    /* ── Track row ─────────────────────────────────────────────── */
    .rd-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 0.9rem;
        border: 1px solid transparent;
        padding: 0.6rem 0.7rem;
        transition: background 0.2s ease, border-color 0.2s ease;
    }
    .rd-row + .rd-row {
        margin-top: 0.25rem;
    }
    .rd-row:hover {
        border-color: rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.045);
    }

    .rd-row-index {
        display: grid;
        height: 1.75rem;
        width: 1.75rem;
        flex-shrink: 0;
        place-items: center;
        border-radius: 0.55rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        font-size: 0.7rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-dim);
        transition: color 0.2s ease, border-color 0.2s ease;
    }
    .rd-row:hover .rd-row-index {
        border-color: rgba(var(--color-primary-rgb), 0.4);
        color: var(--color-primary);
    }
    .rd-row--next .rd-row-index {
        border-color: rgba(var(--color-primary-rgb), 0.45);
        background: rgba(var(--color-primary-rgb), 0.14);
        color: #fff;
    }
    .rd-row--next {
        border-color: rgba(var(--color-primary-rgb), 0.22);
        background: rgba(var(--color-primary-rgb), 0.07);
    }

    .rd-row-body {
        min-width: 0;
        flex: 1;
    }
    .rd-row-title {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 600;
        color: #fff;
    }
    .rd-row-sub {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.72rem;
        color: var(--color-text-dim);
    }

    .rd-row-meta {
        flex-shrink: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-dim);
    }

    .rd-row-actions {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.3rem;
    }

    .rd-act {
        display: inline-flex;
        height: 1.85rem;
        align-items: center;
        gap: 0.3rem;
        border-radius: 0.55rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        padding: 0 0.55rem;
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--color-text-muted);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    }
    .rd-act:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }
    .rd-act--primary {
        border-color: rgba(var(--color-primary-rgb), 0.3);
        background: rgba(var(--color-primary-rgb), 0.12);
        color: var(--color-primary);
    }
    .rd-act--primary:hover {
        background: rgba(var(--color-primary-rgb), 0.22);
        color: #fff;
    }
    .rd-act--live {
        border-color: rgba(52, 211, 153, 0.3);
        background: rgba(52, 211, 153, 0.12);
        color: #34d399;
    }
    .rd-act--live:hover {
        background: rgba(52, 211, 153, 0.22);
        color: #fff;
    }
    .rd-act--danger {
        border-color: rgba(248, 113, 113, 0.25);
        background: rgba(248, 113, 113, 0.1);
        color: #f87171;
        padding: 0 0.45rem;
    }
    .rd-act--danger:hover {
        background: rgba(248, 113, 113, 0.2);
        color: #fff;
    }
    .rd-act.is-done {
        border-color: rgba(52, 211, 153, 0.35);
        background: rgba(52, 211, 153, 0.18);
        color: #34d399;
    }

    /* Actions stay out of the way until the row is hovered on pointer devices */
    @media (hover: hover) and (min-width: 768px) {
        .rd-row .rd-row-actions {
            opacity: 0;
        }
        .rd-row:hover .rd-row-actions,
        .rd-row:focus-within .rd-row-actions {
            opacity: 1;
        }
    }

    /* ── Library playlist chips ────────────────────────────────── */
    .rd-pchip {
        flex-shrink: 0;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        padding: 0.3rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-muted);
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .rd-pchip:hover {
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
    }
    .rd-pchip[aria-pressed='true'] {
        border-color: rgba(var(--color-secondary-rgb), 0.45);
        background: rgba(var(--color-secondary-rgb), 0.16);
        color: #fff;
    }

    .rd-more {
        padding: 0.9rem 0 0.4rem;
        text-align: center;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-dim);
    }
</style>
