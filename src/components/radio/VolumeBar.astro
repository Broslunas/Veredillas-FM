---
---

<div class="volume-control flex items-center gap-3 rounded-full border border-white/10 bg-white/[0.045] px-4 py-2.5 backdrop-blur-xl">
    <button type="button" class="volume-mute-btn shrink-0 text-gray-400 transition-colors hover:text-white" aria-label="Silenciar" title="Silenciar">
        <svg class="volume-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
            <path class="volume-waves transition-opacity duration-300" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path class="volume-waves-outer transition-opacity duration-300" d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
    </button>

    <input
        type="range"
        class="volume-slider h-1.5 w-full min-w-[104px] cursor-pointer appearance-none rounded-full outline-none"
        min="0"
        max="1"
        step="0.01"
        value="0.5"
        aria-label="Volumen"
    />

    <span class="volume-value w-9 shrink-0 text-right font-mono text-[0.7rem] font-bold tabular-nums text-gray-400">50</span>
</div>

<style>
    /* Track is painted with a gradient stop driven by --vol so the filled part reads as "level" */
    .volume-slider {
        -webkit-appearance: none;
        appearance: none;
        background: linear-gradient(
            to right,
            var(--color-primary) 0%,
            var(--color-secondary) calc(var(--vol, 50%) * 0.9),
            rgba(255, 255, 255, 0.14) var(--vol, 50%),
            rgba(255, 255, 255, 0.14) 100%
        );
    }

    .volume-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.25);
        cursor: pointer;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .volume-slider::-moz-range-thumb {
        width: 14px;
        height: 14px;
        border: none;
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.25);
        cursor: pointer;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .volume-slider:hover::-webkit-slider-thumb,
    .volume-slider:focus-visible::-webkit-slider-thumb {
        transform: scale(1.15);
        box-shadow: 0 0 0 5px rgba(var(--color-primary-rgb), 0.3);
    }

    .volume-slider:hover::-moz-range-thumb,
    .volume-slider:focus-visible::-moz-range-thumb {
        transform: scale(1.15);
        box-shadow: 0 0 0 5px rgba(var(--color-primary-rgb), 0.3);
    }
</style>
