---
interface Props {
    isRegistered: boolean;
    isAdmin: boolean;
}

const { isRegistered, isAdmin } = Astro.props;

const stats = [
    { id: 'queue', label: 'En cola', hint: 'pistas' },
    { id: 'library', label: 'Biblioteca', hint: 'pistas' },
    { id: 'playlists', label: 'Listas', hint: 'activas' },
    { id: 'runtime', label: 'Duración', hint: 'de la cola' },
];
---

<aside class="flex flex-col gap-4">

    <!-- ── Station status ────────────────────────────────────────── -->
    <div class="rd-card">
        <div class="rd-card-head">
            <h2 class="rd-card-title">La emisora</h2>
            <span class="rd-status" id="rd-station-status" data-live="false">
                <span class="rd-status-dot"></span>
                <span id="rd-station-status-text">Comprobando…</span>
            </span>
        </div>

        <dl class="grid grid-cols-2 gap-2">
            {stats.map((stat) => (
                <div class="rounded-xl border border-white/[0.07] bg-white/[0.03] p-3">
                    <dd class="font-display text-xl font-extrabold tabular-nums text-white" id={`rd-stat-${stat.id}`}>–</dd>
                    <dt class="mt-0.5 text-[0.68rem] font-semibold text-gray-400">
                        {stat.label} <span class="text-gray-600">· {stat.hint}</span>
                    </dt>
                </div>
            ))}
        </dl>

        <div class="mt-3 flex items-center gap-2 border-t border-white/5 pt-3">
            <span class="text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-gray-500">Modo</span>
            <span class="rd-mode" id="rd-mode-loop" data-on="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
                Bucle
            </span>
            <span class="rd-mode" id="rd-mode-shuffle" data-on="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/></svg>
                Aleatorio
            </span>
        </div>
    </div>

    <!-- ── Playlist mix ──────────────────────────────────────────── -->
    <div class="rd-card">
        <div class="rd-card-head">
            <h2 class="rd-card-title">Qué se pincha</h2>
            <span class="text-[0.65rem] font-semibold text-gray-500">Top listas</span>
        </div>
        <div class="flex flex-col gap-2.5" id="rd-playlist-mix">
            <div class="py-4 text-center text-xs text-gray-500">Cargando…</div>
        </div>
    </div>

    <!-- ── Booth actions ─────────────────────────────────────────── -->
    <div class="rd-card rd-card--cta">
        {isRegistered ? (
            <>
                <div class="rd-card-head">
                    <h2 class="rd-card-title">Tu cabina</h2>
                    {isAdmin && <span class="rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 text-[0.6rem] font-extrabold uppercase tracking-widest text-primary">Admin</span>}
                </div>
                <p class="mb-3 text-xs leading-relaxed text-gray-400">
                    Sube tus temas a la emisora y colócalos en la cola desde el panel.
                </p>
                <div class="flex flex-col gap-2">
                    <button type="button" id="import-song-trigger-btn" class="import-song-trigger-btn rd-btn rd-btn--ghost">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Añadir canción
                    </button>
                    <button type="button" id="dj-trigger-btn" class="rd-btn rd-btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                        Abrir Panel DJ
                    </button>
                </div>
            </>
        ) : (
            <>
                <div class="rd-card-head">
                    <h2 class="rd-card-title">Pide tu canción</h2>
                </div>
                <p class="mb-3 text-xs leading-relaxed text-gray-400">
                    Crea tu cuenta para añadir temas a la biblioteca, colarlos en la cola y usar el Panel DJ.
                </p>
                <a href="/login" class="rd-btn rd-btn--primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Iniciar sesión
                </a>
            </>
        )}
    </div>
</aside>

<style>
    .rd-card {
        border-radius: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.09);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0.38));
        padding: 1rem;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 30px 70px -55px rgba(0, 0, 0, 0.95);
    }

    .rd-card--cta {
        border-color: rgba(var(--color-primary-rgb), 0.22);
        background:
            radial-gradient(circle at 100% 0%, rgba(var(--color-primary-rgb), 0.16), transparent 60%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0.38));
    }

    .rd-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }

    .rd-card-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
    }

    .rd-status {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        padding: 0.2rem 0.6rem;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-dim);
    }
    .rd-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: currentColor;
    }
    .rd-status[data-live='true'] {
        border-color: rgba(52, 211, 153, 0.3);
        background: rgba(52, 211, 153, 0.12);
        color: #34d399;
    }
    .rd-status[data-live='false'] {
        border-color: rgba(249, 115, 22, 0.25);
        background: rgba(249, 115, 22, 0.1);
        color: #fb923c;
    }

    .rd-mode {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        padding: 0.22rem 0.55rem;
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--color-text-dim);
        transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }
    .rd-mode[data-on='true'] {
        border-color: rgba(var(--color-secondary-rgb), 0.4);
        background: rgba(var(--color-secondary-rgb), 0.14);
        color: var(--color-secondary);
    }
    .rd-mode[data-on='false'] {
        opacity: 0.5;
    }

    .rd-btn {
        display: inline-flex;
        width: 100%;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-radius: 0.85rem;
        border: 1px solid transparent;
        padding: 0.65rem 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, filter 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .rd-btn:hover {
        transform: translateY(-1px);
    }
    .rd-btn:active {
        transform: translateY(0);
    }

    .rd-btn--primary {
        background: linear-gradient(135deg, var(--color-primary), #a855f7);
        color: #fff;
        box-shadow: 0 10px 26px -12px rgba(var(--color-primary-rgb), 0.9);
    }
    .rd-btn--primary:hover {
        filter: brightness(1.1);
    }

    .rd-btn--ghost {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
    }
    .rd-btn--ghost:hover {
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.09);
    }
</style>

<!-- Playlist mix rows are rendered from JS -->
<style is:global>
    .rd-mix-row {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }
    .rd-mix-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .rd-mix-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.78rem;
        font-weight: 600;
        color: #e4e4e7;
    }
    .rd-mix-count {
        flex-shrink: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-dim);
    }
    .rd-mix-bar {
        height: 4px;
        overflow: hidden;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.07);
    }
    .rd-mix-fill {
        height: 100%;
        border-radius: 9999px;
        background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
        transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>
